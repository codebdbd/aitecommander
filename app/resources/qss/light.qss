QWidget { color: #1F2430; }
QMainWindow {
background: #FDFDFE;
}
QMainWindow > QFrame {
background: #FDFDFE;
}
QWidget#LeftPanel[sphere="1"] {
background: #F3FBF8;
}
QWidget#LeftPanel[sphere="2"] {
background: #F4F9FF;
}
QWidget#LeftPanel[sphere="3"] {
background: #F8F5FF;
}
QWidget#LeftPanel[sphere="4"] {
background: #FFF7F3;
}
QWidget#spheres_bar QToolButton {
}
QWidget#spheres_bar QToolButton:hover,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:hover {
border-color: #0078D7;
background: transparent;
}
QWidget#spheres_bar QToolButton:checked,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:checked {
border-color: #E0E0E0;
background: #E0E0E0;
}
QWidget#spheres_bar QToolButton:pressed,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:pressed {
border-color: #FFFFFF;
background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
stop: 0 #00427A, stop: 1 #0061B0);
border-style: inset;
}
QWidget#LeftPanel QToolButton:hover {
background: #E6E6E6;
}
#spheres_bar QPushButton:hover {
border-color: #0078D7;
background: #E0E0E0;
}
QMenu {
color: #333333;
background-color: #FFFFFF;
border-color: #CCCCCC;
}
QMenu::item {
color: #333333;
}
QMenu::item:disabled {
color: #999999;
}
QMenu::separator {
background: #B3B3B3;
}
QMenu::item:enabled:hover,
QMenu::item:enabled:selected,
QMenu::item:hover,
QMenu::item:selected {
background-color: #E6E6E6;
color: #000000;
}
QMenu::item:pressed {
background-color: #D0D0D0;
}
QMenu::indicator:checked {
background-color: #0078D7;
border-color: #0078D7;
}
QMenuBar {
background-color: #F0F0F0;
border-top-color: #E0E0E0;
border-bottom-color: #E0E0E0;
}
QMenuBar::item {
color: #444444;
}
QMenuBar::item:selected {
background: #E6E6E6;
color: #000000;
}
QMenuBar::item:pressed {
background: #0F6FD6;
}
QMenuBar QMenu {
background-color: #FFFFFF;
border-color: #E0E0E0;
}
QMainWindow {
background-color: #F5F5F5;
color: #222222;
}
QWidget#topBarHost {
background: #F5F5F5;
}
QWidget#topBarHost QLineEdit {
border-color: #B3B3B3;
}
QWidget#topBarHost QLineEdit:hover,
QWidget#topBarHost QLineEdit:focus {
border-color: #B3B3B3;
}
QWidget#topBarHost QToolButton {
}
QWidget#topBarHost QToolButton#qt_toolbar_ext_button {
qproperty-icon: url(":/icons/light/more.svg");
}
QWidget#topBarHost QPushButton {
}
QWidget#topBarHost QToolButton:hover,
QWidget#topBarHost QPushButton:hover {
border-color: #B3B3B3;
}
QWidget#topBarHost QToolButton:checked,
QWidget#topBarHost QPushButton:checked {
border-color: #B3B3B3;
}
QPushButton {
background-color: #FFFFFF;
border-color: #B3B3B3;
}
QPushButton:hover {
background-color: #E6E6E6;
border-color: #B3B3B3;
}
QToolButton {
background-color: #F4F4F4;
border-color: #B3B3B3;
}
QListWidget#categoryTiles,
QListView#categoryTiles {
background: #F9FAFD;
border: none;
}
QListWidget#categoryTiles::item,
QListView#categoryTiles::item {
background: transparent;
border-color: transparent;
}
QListWidget#categoryTiles::item:hover,
QListView#categoryTiles::item:hover {
background: #E0E0E0;
border-color: #FFFFFF;
}
QListWidget#categoryTiles::item:selected,
QListView#categoryTiles::item:selected {
background: #F0F0F0;
border-color: #E0E0E0;
}
QListWidget#categoryTiles::item:selected:hover,
QListView#categoryTiles::item:selected:hover {
background: #F0F0F0;
border-color: #0078D7;
}
QToolButton:hover {
background-color: #E6E6E6;
border-color: #B3B3B3;
}
QToolButton:pressed {
background-color: #F2F4F7;
border-color: #B3B3B3;
}
QToolButton:checked {
background-color: #1C8FF5;
border-color: #B3B3B3;
}
QLineEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit {
background-color: #F2F4F7;
border-color: #B3B3B3;
}
QComboBox QAbstractItemView {
background-color: #F2F4F7;
selection-background-color: #D0D0D0;
border-color: #B3B3B3;
}
QHeaderView::section {
background-color: #F5F5F5;
border-right-color: #B3B3B3;
color: #444444;
}
QHeaderView {
border-bottom-color: #B3B3B3;
}
QTableView QHeaderView::section:horizontal {
background-color: #F0F0F0;
border-right-color: #B3B3B3;
color: #666666;
}
QTableView QHeaderView {
border-bottom-color: #B3B3B3;
}
QLabel#pathLabel {
color: #555555;
}
QTableView QTableCornerButton::section,
QTableView QTableCornerButton::section:first {
background-color: #F0F0F0;
border-right-color: #B3B3B3;
border-bottom-color: #B3B3B3;
}
QTableView QTableCornerButton::section:alternate {
background-color: #F0F0F0;
}
QTableView QHeaderView::section:vertical {
background-color: #F0F0F0;
color: #666666;
}
QTableView QHeaderView:vertical {
background-color: #F0F0F0;
}
QTableView,
QTableWidget {
background-color: #FFFFFF;
alternate-background-color: #F5F5F5;
}
LinksTableView {
qproperty-openedColColor: #666666;
qproperty-notesColColor: #666666;
}
QTreeView::item:selected,
QTableView::item:selected,
QTableWidget::item:selected {
background-color: #CCE7FF;
color: #000000;
}
QTreeView::item:!selected:hover {
background-color: #E6E6E6;
color: palette(text);
}
QTreeView::item:!selected:hover {
background-color: #E6E6E6;
color: palette(text);
}
QTableView::item:!selected:hover,
QTableWidget::item:!selected:hover {
}
QWidget[class="separator"] {
background-color: #B3B3B3;
}
QWidget[class="vertical_separator"] {
background-color: #B3B3B3;
}
QWidget#topBarHost QToolBar::separator {
background-color: #B3B3B3;
}
QWidget#favQuickSeparatorBefore,
QWidget#favQuickSeparatorAfter {
background-color: #B3B3B3;
}
QStatusBar {
background-color: #F0F0F0;
border-top-color: #B3B3B3;
}
QStatusBar QLabel#dbStatusLabel,
QStatusBar QLabel#linksCountLabel {
color: #6B728C;
font-weight: normal;
}
QWidget#bottomBarContainer {
background-color: #F0F2FA;
}
QWidget#bottomBarContainer QPushButton {
background-color: #F2F4F7;
color: #1F2430;
border-right-color: #B3B3B3;
}
QWidget#bottomBarContainer QPushButton:hover {
    border-color: transparent;
    border-right-color: #B3B3B3;
    background-color: #E6E6E6;
}
QDialog {
background-color: #FFFFFF;
color: #1F2430;
}
QDialog#BrowserProfileDialog,
QDialog#BrowserProfileDialog QScrollArea#profilesScroll,
QDialog#BrowserProfileDialog QWidget#profilesScrollViewport,
QDialog#BrowserProfileDialog QWidget#profilesContent {
background-color: #FFFFFF;
color: #1F2430;
}
QDialog QLineEdit,
QDialog QTextEdit,
QDialog QPlainTextEdit,
QDialog QComboBox,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QDateEdit,
QDialog QTimeEdit {
border-color: #B3B3B3;
background-color: #F2F4F7;
color: #1F2430;
}
QDialog QPushButton,
QDialog QToolButton {
border-color: #B3B3B3;
background-color: #F0F0F0;
color: #1F2430;
}
QDialog QComboBox QAbstractItemView {
border-color: #B3B3B3;
background: #F2F4F7;
}
QDialog QLineEdit:focus,
QDialog QTextEdit:focus,
QDialog QPlainTextEdit:focus,
QDialog QComboBox:focus,
QDialog QSpinBox:focus,
QDialog QDoubleSpinBox:focus,
QDialog QDateEdit:focus,
QDialog QTimeEdit:focus {
border-color: #99CCFF;
}
QDialog QPushButton:focus,
QDialog QToolButton:focus {
border-color: #99CCFF;
}
QDialog QPushButton:focus:hover,
QDialog QToolButton:focus:hover {
border-color: #99CCFF;
}
QDialog QPushButton:disabled,
QDialog QToolButton:disabled {
background: #CCCCCC;
}
QDialog QPushButton:disabled:hover,
QDialog QToolButton:disabled:hover {
background: #CCCCCC;
}
QCheckBox::indicator,
QDialog QCheckBox::indicator {
border-color: #B3B3B3;
background: #FFFFFF;
}
QCheckBox::indicator:hover,
QDialog QCheckBox::indicator:hover {
border-color: #B3B3B3;
}
QCheckBox::indicator:checked,
QDialog QCheckBox::indicator:checked {
background: #1C8FF5;
border-color: #B3B3B3;
image: url(":/icons/light/check.svg");
}
QCheckBox::indicator:disabled,
QDialog QCheckBox::indicator:disabled {
border-color: #B3B3B3;
background: #E6E6E6;
}
QDialog QCheckBox:focus {
border-color: #99CCFF;
}
QDialog QComboBox QAbstractItemView {
border-color: #B3B3B3;
background: #F2F4F7;
}
QComboBox::down-arrow,
QDialog QComboBox::down-arrow {
image: url(":/icons/light/chevron_down.svg");
}
QComboBox QAbstractItemView::item:selected,
QDialog QComboBox QAbstractItemView::item:selected {
background-color: #DBDBDB;
color: #000000;
}
QComboBox QAbstractItemView::item:hover,
QDialog QComboBox QAbstractItemView::item:hover {
background-color: #E6E6E6;
color: #000000;
}
QDialog QPushButton:default:focus,
QDialog QPushButton:autoDefault:focus {
border-color: #99CCFF;
}
QDialog QToolButton#linkTypeBtn {
border-color: #B3B3B3;
}
QDialog QToolButton#linkTypeBtn:hover,
QDialog QToolButton#linkTypeBtn:focus {
border-color: #99CCFF;
background: #E6E6E6;
}
QDialog QToolButton#linkTypeBtn:checked {
