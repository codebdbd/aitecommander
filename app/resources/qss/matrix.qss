QWidget { color: #9EF4A3; }
QWidget#LeftPanel[sphere="1"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #000000, stop: 0.95 #000000,
stop: 0.95 #002200, stop: 1 #002200
);
}
QWidget#LeftPanel[sphere="2"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #000000, stop: 0.95 #000000,
stop: 0.95 #0B3A1D, stop: 1 #0B3A1D
);
}
QWidget#LeftPanel[sphere="3"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #000000, stop: 0.95 #000000,
stop: 0.95 #0A2F24, stop: 1 #0A2F24
);
}
QWidget#LeftPanel[sphere="4"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #000000, stop: 0.95 #000000,
stop: 0.95 #0D3E32, stop: 1 #0D3E32
);
}
QWidget#spheres_bar QToolButton {
}
QWidget#spheres_bar QToolButton:hover,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:hover {
border-color: #3BF989;
background: transparent;
}
QWidget#spheres_bar QToolButton:checked,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:checked {
border-color: #3BF989;
background: #3BF989;
}
QWidget#spheres_bar QToolButton:pressed,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:pressed {
border-color: #FFFFFF;
background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
stop: 0 #136B3C, stop: 1 #2DBF6D);
border-style: inset;
}
QWidget#LeftPanel QToolButton:hover {
background: #001100;
}
#spheres_bar QPushButton:hover {
border-color: #3BF989;
}
QMenu {
color: #9EF4A3;
background-color: #050C07;
border-color: #0F3F24;
}
QMenu::item {
color: #9EF4A3;
}
