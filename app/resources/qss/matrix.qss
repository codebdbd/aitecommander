border-right: 1px solid #0F3F24;
border-bottom: none;
}
QMenuBar::item:pressed {
background: #050C07;
color: #9EF4A3;
border-left: 1px solid #0F3F24;
border-top: 1px solid #0F3F24;
border-right: 1px solid #0F3F24;
border-bottom: none;
}
QMenuBar QMenu {
background-color: #050C07;
border-color: #0F3F24;
}
