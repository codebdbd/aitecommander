QWidget { color: #E0E0E0; }
QMainWindow {
background: #1A1F26;
}
QMainWindow > QFrame {
background: #1A1F26;
}
QWidget#LeftPanel[sphere="1"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #1A1F26, stop: 0.95 #1A1F26,
stop: 0.95 #2E4066, stop: 1 #2E4066
);
}
QWidget#LeftPanel[sphere="2"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #1A1F26, stop: 0.95 #1A1F26,
stop: 0.95 #6A2E44, stop: 1 #6A2E44
);
}
QWidget#LeftPanel[sphere="3"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #1A1F26, stop: 0.95 #1A1F26,
stop: 0.95 #4A375A, stop: 1 #4A375A
);
}
QWidget#LeftPanel[sphere="4"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #1A1F26, stop: 0.95 #1A1F26,
stop: 0.95 #2E5A52, stop: 1 #2E5A52
);
}
QWidget#spheres_bar QToolButton {
}
QWidget#spheres_bar QToolButton:hover,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:hover {
border-color: #2ea8ff;
background: transparent;
}
QWidget#spheres_bar QToolButton:checked,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:checked {
border-color: #2ea8ff;
background: #2ea8ff;
}
QWidget#spheres_bar QToolButton:pressed,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:pressed {
border-color: #FFFFFF;
background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
stop: 0 #0C4B78, stop: 1 #1D79B8);
border-style: inset;
}
QWidget#LeftPanel QToolButton:hover {
background: #1E2633;
}
#spheres_bar QPushButton:hover {
border-color: #0078d7;
}
QMenu {
color: #D1D6E0;
background-color: #2C2F36;
border-color: #3A3E44;
}
QMenu::item {
color: #D1D6E0;
}
QMenu::item:disabled {
color: #5A6372;
}
QMenu::separator {
background: #3A3E44;
}
QMenu::item:enabled:hover,
QMenu::item:enabled:selected,
QMenu::item:hover,
QMenu::item:selected {
background-color: #2E4066;
color: #FFFFFF;
}
QMenu::item:pressed {
background-color: #3D507A;
}
QMenu::indicator:checked {
background-color: #3A6EFF;
border-color: #3A6EFF;
}
QMenuBar {
background-color: #1A1F26;
border-top-color: #3A3E44;
border-bottom-color: #3A3E44;
}
QMenuBar::item {
color: #C9D1DA;
border-left-color: transparent;
border-right-color: transparent;
}
QMenuBar::item:hover,
QMenuBar::item:selected {
background: #252D3A;
color: #FFFFFF;
border-left-color: #3A3E44;
border-right-color: #3A3E44;
}
QMenuBar::item:pressed {
background: #2C2F36;
border-left-color: #3A3E44;
border-right-color: #3A3E44;
}
QMenuBar QMenu {
background-color: #2C2F36;
border-color: #3A3E44;
}
QWidget#topBarHost {
background: #1A1F26;
}
QWidget#topBarHost QLineEdit {
border-color: #3A3E44;
}
QWidget#topBarHost QLineEdit:hover,
QWidget#topBarHost QLineEdit:focus {
border-color: #0194F0;
}
QWidget#topBarHost QToolButton {
}
QWidget#topBarHost QToolButton#qt_toolbar_ext_button {
qproperty-icon: url(":/icons/dark/more.svg");
}
QWidget#topBarHost QPushButton {
}
QWidget#topBarHost QToolButton:hover,
QWidget#topBarHost QPushButton:hover {
border-color: #0194F0;
}
QWidget#topBarHost QToolButton:checked,
QWidget#topBarHost QPushButton:checked {
border-color: #0194F0;
}
QPushButton {
background-color: #252D3A;
border-color: #252D3A;
}
QPushButton:hover {
background-color: #2E4066;
border-color: #0194F0;
}
QToolButton {
background-color: #252D3A;
border-color: #2E4066;
}
QListWidget#categoryTiles,
QListView#categoryTiles {
background: #1A1F26;
border: none;
}
QListWidget#categoryTiles::item,
QListView#categoryTiles::item {
background: transparent;
border-color: transparent;
}
QListWidget#categoryTiles::item:hover,
QListView#categoryTiles::item:hover {
background: #1E2633;
border-color: #FFFFFF;
}
QListWidget#categoryTiles::item:selected,
QListView#categoryTiles::item:selected {
background: #1E2633;
border-color: #0194F0;
}
QListWidget#categoryTiles::item:selected:hover,
QListView#categoryTiles::item:selected:hover {
background: #1E2633;
border-color: #0194F0;
}
QToolButton:hover {
background-color: #2E4066;
border-color: #0194F0;
}
QToolButton:pressed {
background-color: #1E2633;
border-color: #2E4066;
}
QToolButton:checked {
background-color: #3A6EFF;
border-color: #3A6EFF;
}
QLineEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit {
background-color: #252D3A;
border-color: #2E4066;
}
QComboBox QAbstractItemView {
background-color: #252D3A;
selection-background-color: #2E4066;
border-color: #2E4066;
}
QHeaderView::section {
background-color: #1A1F26;
border-right-color: #3A3E44;
color: #C9D1DA;
}
QHeaderView {
border-bottom-color: #3A3E44;
}
QTableView QHeaderView::section:horizontal {
background-color: #202731;
border-right-color: #3A3E44;
color: #BFC7D5;
}
QTableView QHeaderView {
border-bottom-color: #3A3E44;
}
QLabel#pathLabel {
color: #9EA9B7;
}
QTableView QTableCornerButton::section,
QTableView QTableCornerButton::section:first {
background-color: #202731;
border-right-color: #3A3E44;
border-bottom-color: #3A3E44;
}
QTableView QTableCornerButton::section:alternate {
background-color: #202731;
}
QTableView QHeaderView::section:vertical {
background-color: #202731;
color: #BFC7D5;
}
QTableView QHeaderView:vertical {
background-color: #202731;
}
QTableView,
QTableWidget {
background-color: #2D2D2D;
alternate-background-color: #1A1F26;
}
LinksTableView {
qproperty-openedColColor: #A0A7B5;
qproperty-notesColColor: #D0D5E0;
}
QTreeView::item:selected,
QTableView::item:selected,
QTableWidget::item:selected {
background-color: #6A2E44;
color: #FFFFFF;
}
QTreeView::item:!selected:hover {
background-color: #444444;
color: palette(text);
}
QTreeView::item:!selected:hover {
background-color: #444444;
color: palette(text);
}
QWidget[class="separator"] {
background-color: #3A3E44;
}
QWidget[class="vertical_separator"] {
background-color: #3A3E44;
}
QWidget#topBarHost QToolBar::separator {
background-color: #3A3E44;
}
QWidget#favQuickSeparatorBefore,
QWidget#favQuickSeparatorAfter {
background-color: #3A3E44;
}
QStatusBar {
background-color: #202731;
border-top-color: #3A3E44;
}
QStatusBar QLabel#dbStatusLabel,
QStatusBar QLabel#linksCountLabel {
color: #7E8896;
font-weight: normal;
}
QWidget#bottomBarContainer {
background-color: #292929;
}
QWidget#bottomBarContainer QPushButton {
color: #FFFFFF;
border-right-color: #3A3E44;
}
QWidget#bottomBarContainer QPushButton:hover {
background-color: #2E4066;
}
QDialog {
background-color: #1A1F26;
color: #E0E0E0;
}
QDialog#BrowserProfileDialog,
QDialog#BrowserProfileDialog QScrollArea#profilesScroll,
QDialog#BrowserProfileDialog QWidget#profilesScrollViewport,
QDialog#BrowserProfileDialog QWidget#profilesContent {
background-color: #1A1F26;
color: #E0E0E0;
}
QDialog QLineEdit,
QDialog QTextEdit,
QDialog QPlainTextEdit,
QDialog QComboBox,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QDateEdit,
QDialog QTimeEdit {
border-color: #3A3F47;
}
QDialog QPushButton,
QDialog QToolButton {
border-color: #3A3F47;
}
QDialog QPushButton:hover,
QDialog QToolButton:hover {
background: #2E4066;
border-color: #0194F0;
color: #FFFFFF;
}
QDialog QComboBox QAbstractItemView {
border-color: #3A3F47;
}
QDialog QLineEdit:focus,
QDialog QTextEdit:focus,
QDialog QPlainTextEdit:focus,
QDialog QComboBox:focus,
QDialog QSpinBox:focus,
QDialog QDoubleSpinBox:focus,
QDialog QDateEdit:focus,
QDialog QTimeEdit:focus {
border-color: #0194F0;
}
QDialog QPushButton:focus,
QDialog QToolButton:focus {
border-color: #0194F0;
}
QDialog QPushButton:disabled,
QDialog QToolButton:disabled {
background: #3A3A3A;
}
QDialog QPushButton:disabled:hover,
QDialog QToolButton:disabled:hover {
background: #3A3A3A;
}
QCheckBox::indicator,
QDialog QCheckBox::indicator {
border-color: #3A3F47;
background: #1A1F26;
}
QCheckBox::indicator:hover,
QDialog QCheckBox::indicator:hover {
border-color: #0194F0;
}
QCheckBox::indicator:checked,
QDialog QCheckBox::indicator:checked {
background: #0194F0;
border-color: #0194F0;
image: url(":/icons/dark/check.svg");
}
QCheckBox::indicator:disabled,
QDialog QCheckBox::indicator:disabled {
border-color: #3A3F47;
background: #2C2F36;
}
QDialog QCheckBox:focus {
border-color: #0194F0;
}
QDialog QComboBox QAbstractItemView {
border-color: #2A2F3A;
background: #151A22;
}
QComboBox::down-arrow,
QDialog QComboBox::down-arrow {
image: url(":/icons/dark/chevron_down.svg");
}
QComboBox QAbstractItemView::item:selected,
QDialog QComboBox QAbstractItemView::item:selected {
background-color: #6A2E44;
color: #FFFFFF;
}
QComboBox QAbstractItemView::item:hover,
QDialog QComboBox QAbstractItemView::item:hover {
background-color: #252D3A;
}
QDialog QPushButton:default:focus,
QDialog QPushButton:autoDefault:focus {
border-color: #0194F0;
}
QDialog QToolButton#linkTypeBtn:hover {
border-color: #0194F0;
background: #1E2633;
}
QDialog QToolButton#linkTypeBtn:checked {
background: #1E2633;
border-color: #0194F0;
}
QDialog QToolButton#linkTypeBtn:checked:hover {
border-color: #0194F0;
}
QDialog QToolButton#linkTypeBtn[_neon_on="true"] {
border-color: #0194F0;
}
QSplitter::handle { background-color: #3A3E44; }
QSplitter::handle:horizontal { background-color: #3A3E44; }
QSplitter::handle:vertical { background-color: #3A3E44; }
