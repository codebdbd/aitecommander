QWidget { color: #272727; }
QMainWindow {
background: #F5F5F4;
}
QMainWindow > QFrame {
background: #F5F5F4;
}
QWidget#LeftPanel[sphere="1"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #F5F5F4, stop: 0.95 #F5F5F4,
stop: 0.95 #DCE3DF, stop: 1 #DCE3DF
);
}
QWidget#LeftPanel[sphere="2"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #F5F5F4, stop: 0.95 #F5F5F4,
stop: 0.95 #E1DFE7, stop: 1 #E1DFE7
);
}
QWidget#LeftPanel[sphere="3"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #F5F5F4, stop: 0.95 #F5F5F4,
stop: 0.95 #E6DDD8, stop: 1 #E6DDD8
);
}
QWidget#LeftPanel[sphere="4"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #F5F5F4, stop: 0.95 #F5F5F4,
stop: 0.95 #DCE3E8, stop: 1 #DCE3E8
);
}
