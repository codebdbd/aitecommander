QWidget { color: #4A1F2F; }
QWidget#LeftPanel[sphere="1"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #FFF5F8, stop: 0.95 #FFF5F8,
stop: 0.95 #F7D7E7, stop: 1 #F7D7E7
);
}
QWidget#LeftPanel[sphere="2"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #FFF5F8, stop: 0.95 #FFF5F8,
stop: 0.95 #DDEBFF, stop: 1 #DDEBFF
);
}
QWidget#LeftPanel[sphere="3"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #FFF5F8, stop: 0.95 #FFF5F8,
stop: 0.95 #F9EAD8, stop: 1 #F9EAD8
);
}
QWidget#LeftPanel[sphere="4"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #FFF5F8, stop: 0.95 #FFF5F8,
stop: 0.95 #E9E1FA, stop: 1 #E9E1FA
);
}
