/* ============================================================================
   MODERN MINIMAL SCROLLBAR (macOS / Fluent Capsule Style)
   ============================================================================ */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 2px 0 2px 0;
}

QScrollBar::handle:vertical {
    background: rgba(140, 140, 140, 0.35);
    min-height: 28px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(140, 140, 140, 0.65);
}

QScrollBar::handle:vertical:pressed {
    background: rgba(140, 140, 140, 0.85);
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 0 2px 0 2px;
}

QScrollBar::handle:horizontal {
    background: rgba(140, 140, 140, 0.35);
    min-width: 28px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(140, 140, 140, 0.65);
}

QScrollBar::handle:horizontal:pressed {
    background: rgba(140, 140, 140, 0.85);
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}

QMainWindow > QFrame {
    
    border-radius: 0;
    border: none;  
}


QWidget#LeftPanel {
    border: none;
    background: transparent;
}


#spheres_bar QToolButton,
QWidget#LeftPanel QWidget#spheres_bar QToolButton {
    border: none;
    border-radius: 8px;
    padding: 0;
    background: transparent;
}

#spheres_bar QToolButton:hover,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:hover {
    border: none;
    background: transparent;
}

#spheres_bar QToolButton:pressed,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:pressed {
    border: none;
    background: transparent;
}

#spheres_bar QToolButton:checked,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:checked {
    border: none;
    background: transparent;
}

QWidget#LeftPanel QToolButton {
    border: none;
}


QMenu {
    border-radius: 0;
    padding: 0;
    border-style: solid;
    border-width: 1px;
    font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    
}

QMenu::item {
    padding: 0 12px 0 16px;
    margin: 0;
    border-radius: 0;
    background: transparent;
}

QMenu::icon {
    padding-left: 16px;
    
}

QMenu::separator {
    margin: 0;
    padding: 0;
}

QMenu::right-arrow {
    image: none;
    margin-right: 4px;
}

QMenu::icon:disabled {
    opacity: 0.5;
}

QMenu::item:!has-icon {
    padding-left: 16px; 
}

QMenu::item:disabled {
    background: transparent;
}

QMenu::indicator {
    
    margin-left: 4px;
}

QMenu::indicator:checked {
    border-radius: 0;
}

QToolTip {
    border-radius: 0;
    border: 1px solid;
}


QMenuBar {
    padding: 0;
    border-top: 1px solid;
    border-bottom: 1px solid;
    border-left: none;
    border-right: none;
    border-radius: 0;
    spacing: 0;
    margin: 0;
}

QMenuBar::item {
    padding: 0 10px;
    border-radius: 0;
    margin: 0;
    border: 1px solid transparent;
    font-weight: normal;
    background: transparent;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    border: 1px solid palette(highlight);
}


QMenuBar QMenu::item {
    padding: 0 24px 0 8px;
}


QFrame#favoritesPanelBg,
QFrame#quickAddPanelBg {
    border-radius: 0;
    margin: 0;
    padding: 0;
}

QFrame#recentPanelBg {
    border-radius: 0;
    margin: 0;
    padding: 0;
}

QWidget#topBarHost {
    margin: 0;
    padding: 0;
}

QWidget#topBarHost > QWidget {
    margin: 0;
    padding: 0;
}

QWidget#topBarHost QComboBox#themeSelector {
    padding: 0 22px 0 8px;
}

QWidget#topBarHost QToolBar {
    background: transparent;
    border: none;
    spacing: 4px;
}

QWidget#topBarHost QToolBar::separator {
    margin: 0 1px;
    padding: 0;
}

QWidget#topBarHost QToolButton {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    padding: 0;
    margin: 0;
}

QWidget#topBarHost QToolButton:hover,
QWidget#topBarHost QToolButton:pressed,
QWidget#topBarHost QToolButton:checked {
    border-color: transparent;
}

QToolBar#topBarToolbar QToolButton[toolbar_btn="true"] {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    margin-right: 4px;
}

QToolBar#topBarToolbar QToolButton[toolbar_last="true"] {
    margin-right: 0px;
}

QToolBar#topBarToolbar QToolButton#quickButton::menu-indicator,
QToolBar#topBarToolbar QToolButton#favoriteButton::menu-indicator,
QToolBar#topBarToolbar QToolButton#recentButton::menu-indicator {
    image: none;
    width: 0px;
    height: 0px;
}

QWidget#topBarHost QPushButton {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    padding: 0;
    margin: 0;
}

QWidget#topBarHost QPushButton:hover,
QWidget#topBarHost QPushButton:pressed,
QWidget#topBarHost QPushButton:checked {
    border-color: transparent;
}

QWidget#topBarHost QToolButton:focus,
QWidget#topBarHost QPushButton:focus {
    outline: 0;
}

QWidget#topBarHost QLineEdit {
    border: 1px solid;
    border-color: transparent;
    padding: 0 8px;
}

QLineEdit#mainSearch {
    border-radius: 0;
    padding: 0 8px;
}

QLineEdit#mainSearch:hover,
QLineEdit#mainSearch:focus {
    border: 1px solid;
    border-color: transparent;
}


QPushButton {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    padding: 2px 8px 6px 8px;
}

QPushButton:pressed {
    border-style: inset;
}


QToolButton {
    border: 1px solid;
    border-color: transparent;
    padding: 2px 8px 6px 8px;
    border-radius: 0;
}

QToolButton:hover,
QToolButton:pressed,
QToolButton:checked {
    border: 1px solid;
}


QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    padding: 0 4px;
}

QTextEdit,
QPlainTextEdit,
QFrame[input_frame="true"] {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    padding: 2px;
}

QComboBox {
    padding-left: 8px;
    padding-right: 22px;
}

QComboBox QAbstractItemView {
    border: 1px solid;
    border-radius: 0;
}

QComboBox QAbstractItemView::item {
    padding-left: 5px;
}

QComboBox QAbstractItemView:focus,
QComboBox QAbstractItemView::item:focus,
QComboBox QAbstractItemView::item:hover {
    outline: none;
}

QFrame#comboPopupContainer {
    border: 1px solid;
    border-radius: 0;
}

QListView#comboPopupView,
QListView#comboPopupView:focus {
    outline: none;
    border: none;
}

QListView#comboPopupView::item,
QListView#comboPopupView::item:focus,
QListView#comboPopupView::item:selected,
QListView#comboPopupView::item:hover {
    outline: none;
    border: none;
    padding: 0 4px 0 5px;
    min-height: 0;
}

QComboBox::drop-down {
    border: none;
    background: transparent;
    border-radius: 0;
    padding: 0;
    margin: 0;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}

QDialog QComboBox::drop-down {
    border: none;
    background: transparent;
    border-radius: 0;
    padding: 0;
    margin: 0;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}

QComboBox::down-arrow,
QDialog QComboBox::down-arrow {
    margin-right: 6px;
    margin-top: 1px;
}


QHeaderView {
    font-weight: normal;
}

QHeaderView::section {
    border: none;
    padding: 4px;
}

QTableView QHeaderView::section:vertical,
QHeaderView:vertical::section,
QTableView QTableCornerButton::section,
QTableView QTableCornerButton::section:first {
    border: none;
}

QTableView QHeaderView::section:horizontal {
    border-top: none;
    border-bottom: none;
    border-left: none;
    border-right: 1px solid #3A3E44;
    padding: 2px 12px;
}

QTableView QHeaderView::section:horizontal:first {
    border-left: none;
    padding-left: 2px;
    padding-right: 2px;
}

QTableView QHeaderView::section:horizontal:last {
    border-right: none;
    padding-left: 12px;
    padding-right: 12px;
}

QHeaderView::up-arrow,
QHeaderView::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border: none;
    padding: 0px;
    margin: 0px;
}

QTableView QHeaderView,
QTreeView QHeaderView {
    font-weight: normal;
}

QLabel#pathLabel {
    font-weight: normal;
    padding: 2px 8px 2px 8px;
}

QTableView QTableCornerButton::section,
QTableView QTableCornerButton::section:first {
    border: none;
}

QTableView,
QTableWidget {
    border: none;
    border-radius: 0;
    outline: none;
    gridline-color: transparent;
}

QTableView::item,
QTableWidget::item {
    border: none;
    border-radius: 0;
    padding-left: 12px;
    padding-right: 12px;
}

QTreeView::item:selected,
QTableView::item:selected,
QTableWidget::item:selected,
QTreeView::item:hover {
    border: none;
    border-radius: 0;
}

QTreeView::item:!selected:hover {
    color: palette(text);
}

QTreeView {
    background: transparent;
}


QStatusBar {
    border-top: 1px solid;
    border-top-color: transparent;
}

QStatusBar::item {
    border: none;
}

QWidget#bottomBarContainer {
    border: none !important;
    margin: 0;
    padding: 0;
}


QWidget[class="separator"] {
    border: none;
    margin: 0;
    padding: 0;
}

QMenu {
    border-style: solid;
    border-width: 1px;
}

QMenuBar QMenu {
    border-top-width: 1px;
}

QSplitter::handle:horizontal,
QSplitter::handle:vertical {
    margin: 0;
    padding: 0;
}
QSplitter::handle {
    border: none;
}
QSplitter::handle:horizontal {
}
QSplitter::handle:vertical {
}


#spheres_bar {
    border: none;
    margin-bottom: 0;
    border-radius: 0;
    padding: 0;
    background: transparent;
}


QScrollArea,
QTableView,
QTableWidget,
QTreeView,
QListView,
QListWidget {
    border: none;
}

QFrame#comboPopupContainer {
    border: 1px solid;
    border-radius: 0;
    padding: 0;
    margin: 0;
}

QListView#comboPopupView {
    border: none;
    border-radius: 0;
    padding: 0;
    margin: 0;
}

QListWidget#categoryTiles,
QListView#categoryTiles {
    border: none;
    background: transparent;
}

QListWidget#categoryTiles::item,
QListView#categoryTiles::item {
    background: transparent;
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}

QListWidget#categoryTiles::item:hover,
QListView#categoryTiles::item:hover {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}

QListWidget#categoryTiles::item:selected,
QListView#categoryTiles::item:selected {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}

QListWidget#categoryTiles::item:selected:hover,
QListView#categoryTiles::item:selected:hover {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}


QWidget#bottomBarContainer QPushButton {
    background: transparent;
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    border-right: 1px solid;
    border-right-color: transparent;
    margin: 0;
    padding: 0 8px;
}

QWidget#bottomBarContainer QPushButton[last="1"] {
    border-right: none;
}


QDialog QPushButton {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    outline: none;
    padding: 0 14px;
}

QMessageBox QPushButton {
    min-width: 100px;
}

QDialog QToolButton {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    outline: none;
    padding: 0 8px;
}

QDialog QToolButton#linkTypeBtn {
    border-radius: 0;
    padding: 8px 6px;
    margin: 0;
    background: transparent;
    border: 1px solid;
    border-color: transparent;
}

QDialog QPushButton:hover,
QDialog QPushButton:pressed,
QDialog QPushButton:checked,
QDialog QToolButton:hover,
QDialog QToolButton:pressed,
QDialog QToolButton:checked {
    border: 1px solid;
    border-color: transparent;
}

QDialog QLineEdit,
QDialog QTextEdit,
QDialog QPlainTextEdit,
QDialog QComboBox,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QDateEdit,
QDialog QTimeEdit,
QDialog QFrame[input_frame="true"] {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}

QDialog QComboBox {
    padding-left: 8px;
    padding-right: 22px;
}

QDialog QLineEdit,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QDateEdit,
QDialog QTimeEdit {
    padding: 0 4px;
}

QDialog QLineEdit {
    padding: 0 8px;
}


QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}


QCheckBox,
QDialog QCheckBox {
    border: none;
    border-radius: 0;
    outline: none;
    spacing: 6px;
}

QCheckBox:focus,
QDialog QCheckBox:focus {
    outline: none;
    border: none;
}

QCheckBox::indicator,
QDialog QCheckBox::indicator {
    subcontrol-origin: padding;
    subcontrol-position: left center;
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    background: transparent;
    width: 14px;
    height: 14px;
    margin-top: 2px;
}

QTableView::indicator {
    subcontrol-origin: padding;
    subcontrol-position: center;
    border: 1px solid;
    border-color: transparent;
    border-radius: 0px;
    background: transparent;
    width: 12px;
    height: 12px;
    outline: none;
}

QDialog QCheckBox::indicator,
QDialog QCheckBox::indicator:focus,
QTableView::indicator:focus {
    outline: none;
}


QWidget#LeftPanel QToolButton {
    background: transparent;
}

QSplitter::handle {
    background: transparent;
}

QFocusFrame {
    border: 0px;
    outline: none;
    background: transparent;

}


