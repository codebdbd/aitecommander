QMainWindow > QFrame {
    
    border-radius: 0;
    border: none;  
}


QWidget#LeftPanel {
    border: none;
    background: transparent;
}


#spheres_bar QToolButton {
    border: 2px solid;
    border-color: transparent; 
    border-radius: 0;
    padding: 0;
}


#spheres_bar QToolButton:hover,
#spheres_bar QToolButton:pressed,
#spheres_bar QToolButton:checked {
    border: 2px solid;
    border-color: transparent;
    border-radius: 0;
}


QWidget#LeftPanel QToolButton {
    border: none;
}

QWidget#LeftPanel QWidget#spheres_bar QToolButton {
    border: 2px solid;
    border-color: transparent;
    border-radius: 0;
    padding: 0;
}


QMenu {
    border-radius: 0;
    padding: 0;
    border-style: solid;
    border-width: 1px;
    font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    
}

QMenu::item {
    padding: 0 12px 0 16px;
    margin: 0;
    border-radius: 0;
    background: transparent;
}

QMenu::icon {
    padding-left: 16px;
    
}

QMenu::separator {
    margin: 0;
    padding: 0;
}

QMenu::right-arrow {
    image: none;
    margin-right: 4px;
}

QMenu::icon:disabled {
    opacity: 0.5;
}

QMenu::item:!has-icon {
    padding-left: 16px; 
}

QMenu::item:disabled {
    background: transparent;
}

QMenu::indicator {
    
    margin-left: 4px;
}

QMenu::indicator:checked {
    border-radius: 0;
}

QToolTip {
    border-radius: 0;
    border: 1px solid #59F0FF;
    background: #070B14;
    color: #DCE6F2;
}


QMenuBar {
    padding: 0;
    border-top: 1px solid;
    border-bottom: 1px solid;
    border-left: none;
    border-right: none;
    border-radius: 0;
    spacing: 0;
    margin: 0;
}

QMenuBar::item {
    padding: 0 10px;
    border-radius: 0;
    margin: 0;
    border-left: 0px solid;
    border-right: 0px solid;
    
    font-weight: normal;
    background: transparent;
}

QMenuBar::item:hover,
QMenuBar::item:selected,
QMenuBar::item:pressed {
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
}

QMenuBar QMenu {
    margin-top: 6px; 
    padding: 0;
    border-radius: 0;
    border-top-width: 0px;
}

QMenuBar QMenu::item {
    padding: 0 24px 0 8px;
}


QFrame#favoritesPanelBg,
QFrame#quickAddPanelBg {
    border-radius: 0;
    margin: 0;
    padding: 0;
}

QFrame#recentPanelBg {
    border-radius: 0;
    margin: 0;
    padding: 0;
}

QWidget#topBarHost {
    margin: 0;
    padding: 0;
}

QWidget#topBarHost > QWidget {
    margin: 0;
    padding: 0;
}

QWidget#topBarHost QToolBar {
    background: transparent;
    border: none;
}

QWidget#topBarHost QToolBar::separator {
    padding: 0;
}

QWidget#topBarHost QToolButton {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    padding: 0;
    margin: 0;
}

QWidget#topBarHost QToolButton:hover,
QWidget#topBarHost QToolButton:pressed,
QWidget#topBarHost QToolButton:checked {
    border-color: transparent;
}

QWidget#topBarHost QPushButton {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    padding: 0;
    margin: 0;
}

QWidget#topBarHost QPushButton:hover,
QWidget#topBarHost QPushButton:pressed,
QWidget#topBarHost QPushButton:checked {
    border-color: transparent;
}

QWidget#topBarHost QToolButton:focus,
QWidget#topBarHost QPushButton:focus {
    outline: 0;
}

QWidget#topBarHost QLineEdit {
    border: 1px solid;
    border-color: transparent;
    padding: 0 8px;
}

QLineEdit#mainSearch {
    border-radius: 0;
    padding: 0 8px;
    padding-top: 1px;
}

QLineEdit#mainSearch:hover,
QLineEdit#mainSearch:focus {
    border: 1px solid;
    border-color: transparent;
}


QPushButton {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    padding: 4px 8px;
}

QPushButton:pressed {
    border-style: inset;
}


QToolButton {
    border: 1px solid;
    border-color: transparent;
    padding: 4px 8px;
    border-radius: 0;
}

QToolButton:hover,
QToolButton:pressed,
QToolButton:checked {
    border: 1px solid;
}


QLineEdit, QTextEdit, QComboBox, QSpinBox {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    padding: 2px;
}

QComboBox {
    padding-left: 8px;
    padding-right: 22px;
}

QComboBox QAbstractItemView {
    border: 1px solid;
    border-radius: 0;
}

QComboBox QAbstractItemView::item {
    padding-left: 4px;
}

QComboBox QAbstractItemView:focus,
QComboBox QAbstractItemView::item:focus,
QComboBox QAbstractItemView::item:hover {
    outline: none;
}

QComboBox::drop-down {
    border: none;
    background: transparent;
    border-radius: 0;
    padding: 0;
    margin: 0;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}

QDialog QComboBox::drop-down {
    border: none;
    background: transparent;
    border-radius: 0;
    padding: 0;
    margin: 0;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}

QComboBox::down-arrow,
QDialog QComboBox::down-arrow {
    margin-right: 6px;
    margin-top: 1px;
}


QHeaderView {
    font-size: ;
    font-weight: normal;
}

QHeaderView::section {
    border: none;
    padding: 4px;
}

QTableView QHeaderView,
QTreeView QHeaderView {
    font-size: ;
    font-weight: normal;
}

QLabel#pathLabel {
    font-weight: normal;
    padding: 2px 8px;
}

QTableView QTableCornerButton::section,
QTableView QTableCornerButton::section:first {
    border: none;
}

QTableView,
QTableWidget {
    border: none;
    border-radius: 0;
    outline: none;
    gridline-color: transparent;
}

QTableView::item,
QTableWidget::item,
QTreeView::item:selected,
QTableView::item:selected,
QTableWidget::item:selected,
QTreeView::item:hover {
    border: none;
    border-radius: 0;
}

QTreeView::item:!selected:hover {
    color: palette(text);
}

QTreeView {
    background: transparent;
}


QStatusBar {
    border-top: 1px solid;
    border-top-color: transparent;
}

QStatusBar::item {
    border: none;
}

QWidget#bottomBarContainer {
    border: none !important;
    margin: 0;
    padding: 0;
}


QWidget[class="separator"] {
    border: none;
    margin: 0;
    padding: 0;
}

QMenu {
    border-style: solid;
    border-width: 1px;
}

QMenuBar QMenu {
    margin-top: 0px;
    border-top-width: 0px;
}

QSplitter::handle:horizontal,
QSplitter::handle:vertical {
    margin: 0;
    padding: 0;
}
QSplitter::handle {
    border: none;
}
QSplitter::handle:horizontal {
}
QSplitter::handle:vertical {
}


#spheres_bar {
    border: none;
    margin-bottom: 0;
    border-radius: 0;
    padding: 0;
    background: transparent;
}


QAbstractScrollArea {
    border: none;
}

QListWidget#categoryTiles,
QListView#categoryTiles {
    border: none;
    background: transparent;
}

QListWidget#categoryTiles::item,
QListView#categoryTiles::item {
    background: transparent;
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}

QListWidget#categoryTiles::item:hover,
QListView#categoryTiles::item:hover {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}

QListWidget#categoryTiles::item:selected,
QListView#categoryTiles::item:selected {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}

QListWidget#categoryTiles::item:selected:hover,
QListView#categoryTiles::item:selected:hover {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}


QWidget#bottomBarContainer QPushButton {
    background: transparent;
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    border-right: 1px solid;
    border-right-color: transparent;
    margin: 0;
}

QWidget#bottomBarContainer QPushButton[last="1"] {
    border-right: none;
}


QDialog QPushButton {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    outline: none;
    padding: 6px 14px;
}

QDialog QToolButton {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    outline: none;
}

QDialog QToolButton#linkTypeBtn {
    border-radius: 0;
    padding: 8px 6px;
    margin: 0;
    background: transparent;
    border: 1px solid;
    border-color: transparent;
}

QDialog QPushButton:hover,
QDialog QPushButton:pressed,
QDialog QPushButton:checked,
QDialog QToolButton:hover,
QDialog QToolButton:pressed,
QDialog QToolButton:checked {
    border: 1px solid;
    border-color: transparent;
}

QDialog QLineEdit,
QDialog QTextEdit,
QDialog QPlainTextEdit,
QDialog QComboBox,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QDateEdit,
QDialog QTimeEdit {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}

QDialog QComboBox {
    padding-left: 8px;
    padding-right: 22px;
}

QDialog QLineEdit,
QDialog QComboBox,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QDateEdit,
QDialog QTimeEdit {
}

QDialog QLineEdit {
    padding: 0 8px;
}


QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}

QCheckBox,
QDialog QCheckBox {
    border: none;
    border-radius: 0;
    outline: none;
}

QCheckBox:focus,
QDialog QCheckBox:focus {
    outline: none;
    border: none;
}

QCheckBox::indicator,
QDialog QCheckBox::indicator {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    background: transparent;
    width: 14px;
    height: 14px;
    margin-right: 4px;
}

QDialog QCheckBox::indicator,
QDialog QCheckBox::indicator:focus {
    outline: none;
}


QWidget#LeftPanel QToolButton {
    background: transparent;
}

QSplitter::handle {
    background: transparent;
}

QFocusFrame {
    border: 0px;
    outline: none;
    background: transparent;

}
