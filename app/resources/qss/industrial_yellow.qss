QWidget { color: #F3F3F3; }
QMainWindow {
background: #0B0B0B;
}
QMainWindow > QFrame {
background: #0B0B0B;
}
QWidget#LeftPanel[sphere="1"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #0B0B0B, stop: 0.95 #0B0B0B,
stop: 0.95 #52652B, stop: 1 #52652B
);
}
QWidget#LeftPanel[sphere="2"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #0B0B0B, stop: 0.95 #0B0B0B,
stop: 0.95 #8A7410, stop: 1 #8A7410
);
}
QWidget#LeftPanel[sphere="3"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #0B0B0B, stop: 0.95 #0B0B0B,
stop: 0.95 #8A4A15, stop: 1 #8A4A15
);
}
QWidget#LeftPanel[sphere="4"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #0B0B0B, stop: 0.95 #0B0B0B,
stop: 0.95 #285C58, stop: 1 #285C58
);
}
QWidget#spheres_bar QToolButton {
}
QWidget#spheres_bar QToolButton:hover,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:hover {
border-color: #FFCD11;
background: transparent;
}
QWidget#spheres_bar QToolButton:checked,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:checked {
border-color: #FFCD11;
background: #FFCD11;
}
QWidget#spheres_bar QToolButton:pressed,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:pressed {
border-color: #FFFFFF;
background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
stop: 0 #66530A, stop: 1 #FFD633);
}
QWidget#LeftPanel QToolButton:hover {
background: #161616;
}
#spheres_bar QPushButton:hover {
border-color: #FFCD11;
}
