}
QWidget#LeftPanel[sphere="1"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #070914, stop: 0.95 #070914,
stop: 0.95 #123A56, stop: 1 #123A56
);
}
QWidget#LeftPanel[sphere="2"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #070914, stop: 0.95 #070914,
