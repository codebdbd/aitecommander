background: #11151B;
}
QWidget#LeftPanel[sphere="1"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #11151B, stop: 0.95 #11151B,
stop: 0.95 #35546B, stop: 1 #35546B
);
}
QWidget#LeftPanel[sphere="2"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #11151B, stop: 0.95 #11151B,
stop: 0.95 #73526E, stop: 1 #73526E
);
}
QWidget#LeftPanel[sphere="3"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #11151B, stop: 0.95 #11151B,
stop: 0.95 #61506F, stop: 1 #61506F
);
}
QWidget#LeftPanel[sphere="4"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #11151B, stop: 0.95 #11151B,
stop: 0.95 #2E6A63, stop: 1 #2E6A63
);
}
