QWidget { color: #302A31; }
QMainWindow {
background: #F7F3F6;
}
QMainWindow > QFrame {
background: #F7F3F6;
}
QWidget#LeftPanel[sphere="1"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #F7F3F6, stop: 0.95 #F7F3F6,
stop: 0.95 #CFE8D8, stop: 1 #CFE8D8
);
}
QWidget#LeftPanel[sphere="2"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #F7F3F6, stop: 0.95 #F7F3F6,
stop: 0.95 #DED2EE, stop: 1 #DED2EE
);
}
QWidget#LeftPanel[sphere="3"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #F7F3F6, stop: 0.95 #F7F3F6,
stop: 0.95 #F1D0C2, stop: 1 #F1D0C2
);
}
QWidget#LeftPanel[sphere="4"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #F7F3F6, stop: 0.95 #F7F3F6,
stop: 0.95 #C9DFEC, stop: 1 #C9DFEC
);
}
