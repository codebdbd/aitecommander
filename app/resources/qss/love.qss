);
}
QWidget#LeftPanel[sphere="3"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #211217, stop: 0.95 #211217,
stop: 0.95 #7B3C52, stop: 1 #7B3C52
);
}
QWidget#LeftPanel[sphere="4"] {
