QWidget { color: #F7E6F7; }
QMainWindow {
background: #1A1028;
}
QMainWindow > QFrame {
background: #1A1028;
}
QWidget#LeftPanel[sphere="1"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #1A1028, stop: 0.95 #1A1028,
stop: 0.95 #8A2F76, stop: 1 #8A2F76
);
}
QWidget#LeftPanel[sphere="2"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #1A1028, stop: 0.95 #1A1028,
stop: 0.95 #B82C73, stop: 1 #B82C73
);
}
QWidget#LeftPanel[sphere="3"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #1A1028, stop: 0.95 #1A1028,
stop: 0.95 #7C3A78, stop: 1 #7C3A78
);
}
QWidget#LeftPanel[sphere="4"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #1A1028, stop: 0.95 #1A1028,
stop: 0.95 #5A2A82, stop: 1 #5A2A82
);
}
QWidget#spheres_bar QToolButton {
    color: #FF4FA3;
    border: none;
    border-radius: 8px;
}
QWidget#spheres_bar QToolButton:hover,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:hover,
QWidget#spheres_bar QToolButton:checked,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:checked,
QWidget#spheres_bar QToolButton:checked:hover,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:checked:hover {
    border: none;
    background: transparent;
}
QWidget#spheres_bar QToolButton:pressed,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:pressed {
    border: none;
    background: transparent;
}
QWidget#LeftPanel QToolButton:hover {
background: #2B1535;
}
#spheres_bar QPushButton:hover {
border-color: #FF4FA3;
}
QMenu {
color: #F9DFF6;
background-color: #33203F;
border-color: #B66CFF;
}
QMenu::item {
color: #F9DFF6;
}
QMenu::item:disabled {
color: #B07AA9;
}
QMenu::separator {
background: #43214C;
}
QMenu::item:enabled:hover,
QMenu::item:enabled:selected,
QMenu::item:hover,
QMenu::item:selected {
background-color: #8A2F76;
color: #FFFFFF;
}
QMenu::item:pressed {
background-color: #8A2F76;
color: #FFFFFF;
}
QMenu::indicator:checked {
background-color: #FF5CC3;
border-color: #FF5CC3;
}
QToolTip {
border-color: #FF4FA3;
background: #2A1634;
color: #F9DFF6;
}
QMenuBar {
background-color: #33203F;
border-top-color: #43214C;
border-bottom-color: #43214C;
}
QMenuBar::item {
color: #F6D4F2;
}
QMenuBar::item:hover {
background: #36163F;
color: #FFFFFF;
border-color: #B66CFF;
}
QMenuBar::item:selected {
background: #33203F;
color: #F9DFF6;
border-color: #B66CFF;
}
QMenuBar::item:pressed {
background: #33203F;
color: #F9DFF6;
border-color: #B66CFF;
}
QMenuBar QMenu {
background-color: #33203F;
border-color: #B66CFF;
}
QWidget#topBarHost {
background: #1A1028;
}
QWidget#topBarHost QLineEdit {
border-color: #43214C;
}
QWidget#topBarHost QLineEdit:hover,
QWidget#topBarHost QLineEdit:focus {
border-color: #FF4FA3;
}
QWidget#topBarHost QToolButton {
}
QWidget#topBarHost QToolButton#qt_toolbar_ext_button {
qproperty-icon: url(":/icons/violet_pulse/more.svg");
}
QWidget#topBarHost QPushButton {
}
QWidget#topBarHost QToolButton:hover,
QWidget#topBarHost QPushButton:hover {
border-color: #FF4FA3;
}
QWidget#topBarHost QToolButton:checked,
QWidget#topBarHost QPushButton:checked {
border-color: #FF4FA3;
}
QPushButton {
background-color: #36163F;
border-color: #36163F;
}
QPushButton:hover {
background-color: #8A2F76;
border-color: #FF4FA3;
}
QToolButton {
background-color: #36163F;
border-color: #8A2F76;
}
QListWidget#categoryTiles,
QListView#categoryTiles {
qproperty-selectedTextColor: #FFFFFF;
background: #21102A;
border: none;
}
QListWidget#categoryTiles::item,
QListView#categoryTiles::item {
background: transparent;
border-color: transparent;
}
QListView#categoryTiles::item:hover {
background: rgba(255, 255, 255, 0.05);
border-color: transparent;
}
QListView#categoryTiles::item:selected {
background: rgba(255, 255, 255, 0.08);
border-color: #FF4FA3;
}
QListView#categoryTiles::item:selected:hover {
background: rgba(255, 255, 255, 0.12);
border-color: #FF4FA3;
}
QToolButton:hover {
background-color: #8A2F76;
border-color: #FF4FA3;
}
QToolButton:pressed {
background-color: #2B1535;
border-color: #8A2F76;
}
QToolButton:checked {
background-color: #FF5CC3;
border-color: #FF5CC3;
}
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit {
background-color: #36163F;
border-color: #8A2F76;
}
QComboBox QAbstractItemView {
background-color: #36163F;
selection-background-color: #8A2F76;
border-color: #8A2F76;
}
QHeaderView::section {
background-color: #1A1028;
border-right-color: #43214C;
color: #F6D4F2;
}
QHeaderView {
border-bottom-color: #43214C;
}
QTableView QHeaderView::section:horizontal {
background-color: #221129;
border-right-color: #43214C;
border-bottom-color: #43214C;
color: #B66CFF;
}
QTableView QHeaderView {
border-bottom-color: #43214C;
}
QLabel#pathLabel {
color: #D9A1D6;
}
QTableView QTableCornerButton::section,
QTableView QTableCornerButton::section:first {
background-color: #221129;
border-right-color: #43214C;
border-bottom-color: #43214C;
}
QTableView QTableCornerButton::section:alternate {
background-color: #221129;
}
QTableView QHeaderView::section:vertical {
background-color: #221129;
color: #E3B2DE;
}
QTableView QHeaderView:vertical {
background-color: #221129;
}
QTableView,
QTableWidget {
background-color: #221129;
alternate-background-color: #1A1028;
}
LinksTableView {
qproperty-openedColColor: #D48BC7;
qproperty-notesColColor: #F2C9EA;
qproperty-hoverRowColor: #4C1F54;
}
QTreeView::item:selected,
QTableView::item:selected,
QTableWidget::item:selected {
background-color: #B82C73;
color: #FFFFFF;
selection-color: #FFFFFF;
}
QTreeView::item:!selected:hover {
background-color: #4C1F54;
color: palette(text);
}
QWidget[class="separator"] {
background-color: #43214C;
}
QWidget[class="vertical_separator"] {
background-color: #43214C;
}
QWidget#topBarHost QToolBar::separator {
background-color: #43214C;
}
QWidget#favQuickSeparatorBefore,
QWidget#favQuickSeparatorAfter {
background-color: #43214C;
}
QStatusBar {
background-color: #221129;
border-top-color: #43214C;
}
QStatusBar QLabel#dbStatusLabel,
QStatusBar QLabel#linksCountLabel {
color: #C08FC8;
font-weight: normal;
}
QWidget#bottomBarContainer {
background-color: #231026;
}
QWidget#bottomBarContainer QPushButton {
color: #FFFFFF;
border-right-color: #43214C;
}
QWidget#bottomBarContainer QPushButton:hover {
