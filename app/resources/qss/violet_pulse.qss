}
QFrame#linkTypeContainer {
border-color: #3D2B5E;
}
QDialog QToolButton#linkTypeBtn {
color: #F7E6F7;
}
QDialog QToolButton#linkTypeBtn:hover {
background: rgba(255, 255, 255, 0.05);
border-bottom: 2px solid transparent;
color: #F7E6F7;
}
QDialog QToolButton#linkTypeBtn:checked {
background: rgba(255, 255, 255, 0.08);
border-bottom: 2px solid #FF4FA3;
color: #F7E6F7;
}
QDialog QToolButton#linkTypeBtn:checked:hover {
background: rgba(255, 255, 255, 0.12);
border-bottom: 2px solid #FF4FA3;
color: #F7E6F7;
}
QDialog QToolButton#linkTypeBtn[_neon_on="true"] {
border-bottom: 2px solid #FF4FA3;
color: #F7E6F7;
}
QSplitter::handle { background-color: #43214C; }
QSplitter::handle:horizontal { background-color: #43214C; }
QSplitter::handle:vertical { background-color: #43214C; }
#spheres_bar {
}
QWidget#topBarHost QToolButton#quickButton,
QWidget#topBarHost QToolButton#favoriteButton,
QWidget#topBarHost QToolButton#recentButton,
QToolBar#topBarToolbar QToolButton[toolbar_btn="true"],
QToolButton#quickButton,
QToolButton#favoriteButton,
QToolButton#recentButton {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0   #3D1948,
stop: 0.5 #36163F,
stop: 1   #2B1535
);
}

