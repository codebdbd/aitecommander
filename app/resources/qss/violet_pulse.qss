}
QDialog {
background-color: #1A1028;
color: #F7E6F7;
}
QDialog#BrowserProfileDialog,
QDialog#BrowserProfileDialog QScrollArea#profilesScroll,
QDialog#BrowserProfileDialog QWidget#profilesScrollViewport,
QDialog#BrowserProfileDialog QWidget#profilesContent {
background-color: #1A1028;
color: #F7E6F7;
}
QDialog QLineEdit,
QDialog QTextEdit,
QDialog QPlainTextEdit,
QDialog QComboBox,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QDateEdit,
QDialog QTimeEdit {
