QWidget { color: #F3F0F1; }
QMainWindow {
background: #0B0B0D;
}
QMainWindow > QFrame {
background: #0B0B0D;
}
QWidget#LeftPanel[sphere="1"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #0B0B0D, stop: 0.95 #0B0B0D,
stop: 0.95 #351018, stop: 1 #351018
);
}
QWidget#LeftPanel[sphere="2"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #0B0B0D, stop: 0.95 #0B0B0D,
stop: 0.95 #4A101A, stop: 1 #4A101A
);
}
QWidget#LeftPanel[sphere="3"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #0B0B0D, stop: 0.95 #0B0B0D,
stop: 0.95 #60121F, stop: 1 #60121F
);
}
QWidget#LeftPanel[sphere="4"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #0B0B0D, stop: 0.95 #0B0B0D,
stop: 0.95 #421018, stop: 1 #421018
);
}
