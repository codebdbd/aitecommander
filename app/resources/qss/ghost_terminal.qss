QWidget { color: @text_primary; }
QMainWindow {
background: @bg_canvas;
}
QMainWindow > QFrame {
background: @bg_canvas;
}
QWidget#LeftPanel[sphere="1"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 @bg_canvas, stop: 0.95 @bg_canvas,
stop: 0.95 #0E6E3B, stop: 1 #0E6E3B
);
}
QWidget#LeftPanel[sphere="2"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 @bg_canvas, stop: 0.95 @bg_canvas,
stop: 0.95 #0B5842, stop: 1 #0B5842
);
}
QWidget#LeftPanel[sphere="3"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 @bg_canvas, stop: 0.95 @bg_canvas,
stop: 0.95 #11652E, stop: 1 #11652E
);
}
QWidget#LeftPanel[sphere="4"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 @bg_canvas, stop: 0.95 @bg_canvas,
stop: 0.95 #0A5960, stop: 1 #0A5960
);
}
QWidget#spheres_bar QToolButton {
    color: @text_accent;
    border: none;
    border-radius: 8px;
}
QWidget#spheres_bar QToolButton:hover,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:hover,
QWidget#spheres_bar QToolButton:checked,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:checked,
QWidget#spheres_bar QToolButton:checked:hover,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:checked:hover {
    border: none;
    background: transparent;
}
QWidget#spheres_bar QToolButton:pressed,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:pressed {
    border: none;
    background: transparent;
}
QWidget#LeftPanel QToolButton:hover {
background: #0B1710;
}
#spheres_bar QPushButton:hover {
border-color: #2EEA76;
}
QMenu {
color: #D7F4DF;
background-color: #0C120E;
border-color: @text_accent;
}
QMenu::item {
color: #D7F4DF;
}
QMenu::item:disabled {
color: #688273;
}
QMenu::separator {
background: #1E3A28;
}
QMenu::item:enabled:hover,
QMenu::item:enabled:selected,
QMenu::item:hover,
QMenu::item:selected {
background-color: #123D24;
color: #F3FFF7;
}
QMenu::item:pressed {
background-color: #123D24;
color: #F3FFF7;
}
QMenu::indicator:checked {
background-color: #147A3B;
border-color: #147A3B;
}
QToolTip {
border-color: #57FF9D;
background: #020403;
color: #E9FFF0;
}
QMenuBar {
background-color: #0C120E;
border-top-color: @border_subtle;
border-bottom-color: @border_subtle;
}
QMenuBar::item {
color: #C7DED0;
}
QMenuBar::item:hover {
background: #0D1510;
color: #F3FFF7;
border-color: @text_accent;
}
QMenuBar::item:selected {
background: #0C120E;
color: #D7F4DF;
border-color: @text_accent;
}
QMenuBar::item:pressed {
background: #0C120E;
color: #D7F4DF;
border-color: @text_accent;
}
QMenuBar QMenu {
background-color: #0C120E;
border-color: @text_accent;
}
QWidget#topBarHost {
background: @bg_canvas;
}
QWidget#topBarHost QLineEdit {
border-color: @border_subtle;
}
QWidget#topBarHost QLineEdit:hover,
QWidget#topBarHost QLineEdit:focus {
border-color: @text_accent;
}
QWidget#topBarHost QToolButton {
}
QWidget#topBarHost QToolButton#qt_toolbar_ext_button {
qproperty-icon: url(":/icons/dark/more.svg");
}
QWidget#topBarHost QPushButton {
}
QWidget#topBarHost QToolButton:hover,
QWidget#topBarHost QPushButton:hover {
border-color: @text_accent;
}
QWidget#topBarHost QToolButton:checked,
QWidget#topBarHost QPushButton:checked {
border-color: @text_accent;
}
QPushButton {
background-color: #0D1510;
border-color: @border_subtle;
}
QPushButton:hover {
background-color: #123D24;
border-color: @text_accent;
}
QToolButton {
background-color: #0D1510;
border-color: @border_subtle;
}
QListWidget#categoryTiles,
QListView#categoryTiles {
qproperty-selectedTextColor: #E7FFED;
background: @bg_canvas;
border: none;
}
QListWidget#categoryTiles::item,
QListView#categoryTiles::item {
background: transparent;
border-color: transparent;
}
QListView#categoryTiles::item:hover {
background: rgba(255, 255, 255, 0.05);
border-color: transparent;
}
QListView#categoryTiles::item:selected {
background: rgba(255, 255, 255, 0.08);
border-color: @text_accent;
}
QListView#categoryTiles::item:selected:hover {
background: rgba(255, 255, 255, 0.12);
border-color: @text_accent;
}
QToolButton:hover {
background-color: #123D24;
border-color: @text_accent;
}
QToolButton:pressed {
background-color: #0B1710;
border-color: @border_subtle;
}
QToolButton:checked {
background-color: #147A3B;
border-color: #147A3B;
}
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit {
background-color: #0D1510;
border-color: @border_subtle;
}
QComboBox QAbstractItemView {
background-color: #0D1510;
selection-background-color: #123D24;
border-color: @border_subtle;
}
QHeaderView::section {
background-color: @bg_canvas;
border-right-color: @border_subtle;
color: #C7DED0;
}
QHeaderView {
border-bottom-color: @border_subtle;
}
QTableView QHeaderView::section:horizontal {
background-color: @bg_header;
border-right-color: @border_subtle;
border-bottom-color: @border_subtle;
color: @text_accent;
}
QTableView QHeaderView {
border-bottom-color: @border_subtle;
}
QLabel#pathLabel {
color: #8EAB97;
}
QTableView QTableCornerButton::section,
QTableView QTableCornerButton::section:first {
background-color: @bg_header;
border-right-color: @border_subtle;
border-bottom-color: @border_subtle;
}
QTableView QTableCornerButton::section:alternate {
background-color: @bg_header;
}
QTableView QHeaderView::section:vertical {
background-color: @bg_header;
color: #B9D1C0;
}
QTableView QHeaderView:vertical {
background-color: @bg_header;
}
QTableView,
QTableWidget {
background-color: @bg_surface;
alternate-background-color: #050806;
}
LinksTableView {
qproperty-openedColColor: #98BBA4;
qproperty-notesColColor: #D1E8D7;
qproperty-hoverRowColor: #102A1A;
}
QTreeView::item:selected,
QTableView::item:selected,
QTableWidget::item:selected {
background-color: @selection_bg;
color: @selection_fg;
selection-color: @selection_fg;
}
QTreeView::item:!selected:hover {
background-color: @hover_bg;
color: palette(text);
}
QWidget[class="separator"] {
background-color: #1E3A28;
}
QWidget[class="vertical_separator"] {
background-color: #1E3A28;
}
QWidget#topBarHost QToolBar::separator {
background-color: #1E3A28;
}
QWidget#favQuickSeparatorBefore,
QWidget#favQuickSeparatorAfter {
background-color: #1E3A28;
}
QStatusBar {
background-color: @bg_header;
border-top-color: @border_subtle;
}
QStatusBar QLabel#dbStatusLabel,
QStatusBar QLabel#linksCountLabel {
color: #779483;
font-weight: normal;
}
QWidget#bottomBarContainer {
background-color: #0B1710;
}
QWidget#bottomBarContainer QPushButton {
color: #F3FFF7;
border-right-color: @border_subtle;
}
QWidget#bottomBarContainer QPushButton:hover {
background-color: #123D24;
}
QDialog {
background-color: @bg_canvas;
color: @text_primary;
}
QDialog#BrowserProfileDialog,
QDialog#BrowserProfileDialog QScrollArea#profilesScroll,
QDialog#BrowserProfileDialog QWidget#profilesScrollViewport,
QDialog#BrowserProfileDialog QWidget#profilesContent {
background-color: @bg_canvas;
color: @text_primary;
}
QDialog QLineEdit,
QDialog QTextEdit,
QDialog QPlainTextEdit,
QDialog QComboBox,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QDateEdit,
QDialog QTimeEdit,
QDialog QTableView,
QDialog QTableWidget {
border-color: @border_subtle;
}
QDialog QPushButton,
QDialog QToolButton {
border-color: @border_subtle;
}
QDialog QPushButton:hover,
QDialog QToolButton:hover {
background: #123D24;
border-color: @text_accent;
color: #F3FFF7;
}
QDialog QLineEdit:focus,
QDialog QTextEdit:focus,
QDialog QPlainTextEdit:focus,
QDialog QComboBox:focus,
QDialog QSpinBox:focus,
QDialog QDoubleSpinBox:focus,
QDialog QDateEdit:focus,
QDialog QTimeEdit:focus {
border-color: @text_accent;
}
QDialog QPushButton:focus,
QDialog QToolButton:focus {
border-color: @text_accent;
}
QDialog QPushButton:disabled,
QDialog QToolButton:disabled {
background: #142019;
  color: #688273;
  border-color: #142019;
}
QDialog QPushButton:disabled:hover,
QDialog QToolButton:disabled:hover {
background: #142019;
  color: #688273;
  border-color: #142019;
}
QCheckBox::indicator,
QDialog QCheckBox::indicator {
border-color: @border_subtle;
background: @bg_canvas;
}
QCheckBox::indicator:hover,
QDialog QCheckBox::indicator:hover {
border-color: @text_accent;
}
QCheckBox::indicator:checked,
QDialog QCheckBox::indicator:checked {
background: #0D421F;
border-color: @text_accent;
image: url(":/icons/dark/check.svg");
}
QCheckBox::indicator:disabled,
QDialog QCheckBox::indicator:disabled {
border-color: @border_subtle;
background: #101A14;
}
QDialog QCheckBox:focus {
border-color: @text_accent;
}
QDialog QComboBox QAbstractItemView,
QFrame#comboPopupContainer,
QListView#comboPopupView {
border-color: @border_subtle;
background: #0D1510;
}
QComboBox::down-arrow,
QDialog QComboBox::down-arrow {
image: url(":/icons/dark/chevron_down.svg");
}
QComboBox QAbstractItemView::item:selected,
QDialog QComboBox QAbstractItemView::item:selected,
QListView#comboPopupView::item:selected {
background-color: @selection_bg;
color: @selection_fg;
}
QComboBox QAbstractItemView::item:hover,
QDialog QComboBox QAbstractItemView::item:hover,
QListView#comboPopupView::item:hover {
background-color: #123D24;
}
QDialog QPushButton:default:focus,
QDialog QPushButton:autoDefault:focus {
border-color: @text_accent;
}
QFrame#linkTypeContainer {
border-color: #223322;
}
QDialog QToolButton#linkTypeBtn {
color: @text_primary;
}
QDialog QToolButton#linkTypeBtn:hover {
background: rgba(255, 255, 255, 0.05);
border-bottom: 2px solid transparent;
color: @text_primary;
}
QDialog QToolButton#linkTypeBtn:checked {
background: rgba(255, 255, 255, 0.08);
border-bottom: 2px solid @text_accent;
color: @text_primary;
}
QDialog QToolButton#linkTypeBtn:checked:hover {
background: rgba(255, 255, 255, 0.12);
border-bottom: 2px solid @text_accent;
color: @text_primary;
}
QDialog QToolButton#linkTypeBtn[_neon_on="true"] {
border-bottom: 2px solid @text_accent;
color: @text_primary;
}
QSplitter::handle { background-color: #1E3A28; }
QSplitter::handle:horizontal { background-color: #1E3A28; }
QSplitter::handle:vertical { background-color: #1E3A28; }
#spheres_bar {
}
QWidget#topBarHost QToolButton#quickButton,
QWidget#topBarHost QToolButton#favoriteButton,
QWidget#topBarHost QToolButton#recentButton,
QToolBar#topBarToolbar QToolButton[toolbar_btn="true"],
QToolButton#quickButton,
QToolButton#favoriteButton,
QToolButton#recentButton {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0   #0D2818,
stop: 0.5 #0D1510,
stop: 1   #0B1710
);
}

/* Unified state matrix: begin */
QMenu::item:enabled:hover,
QMenu::item:hover,
QMenuBar::item:hover,
QPushButton:hover,
QToolButton:hover,
QDialog QPushButton:hover,
QDialog QToolButton:hover,
QWidget#topBarHost QToolButton:hover,
QWidget#topBarHost QPushButton:hover,
QWidget#bottomBarContainer QPushButton:hover,
QTreeView::item:!selected:hover,
QComboBox QAbstractItemView::item:hover,
QDialog QComboBox QAbstractItemView::item:hover,
QListView#comboPopupView::item:hover {
background-color: @hover_bg;
color: #F3FFF7;
}
QTreeView::item:selected,
QTableView::item:selected,
QTableWidget::item:selected {
background-color: @selection_bg;
color: @selection_fg;
selection-color: @selection_fg;
}
#spheres_bar QPushButton:hover,
QPushButton:hover,
QPushButton:pressed,
QPushButton:checked,
QToolButton:hover,
QToolButton:pressed,
QToolButton:checked,
QDialog QPushButton:hover,
QDialog QPushButton:pressed,
QDialog QPushButton:checked,
QDialog QToolButton:hover,
QDialog QToolButton:pressed,
QDialog QToolButton:checked,
QDialog QPushButton:focus,
QDialog QToolButton:focus,
QDialog QPushButton:default:focus,
QDialog QPushButton:autoDefault:focus,
QWidget#topBarHost QLineEdit:hover,
QWidget#topBarHost QLineEdit:focus,
QWidget#topBarHost QToolButton:hover,
QWidget#topBarHost QToolButton:pressed,
QWidget#topBarHost QToolButton:checked,
QWidget#topBarHost QPushButton:hover,
QWidget#topBarHost QPushButton:pressed,
QWidget#topBarHost QPushButton:checked,
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDialog QLineEdit:focus,
QDialog QTextEdit:focus,
QDialog QPlainTextEdit:focus,
QDialog QComboBox:focus,
QDialog QSpinBox:focus,
QDialog QDoubleSpinBox:focus,
QDialog QDateEdit:focus,
QDialog QTimeEdit:focus,
QCheckBox::indicator:hover,
QDialog QCheckBox::indicator:hover,
QCheckBox::indicator:checked,
QDialog QCheckBox::indicator:checked,
QDialog QCheckBox:focus,
QToolButton#quickButton:hover,
QToolButton#quickButton:pressed,
QToolButton#quickButton:checked,
QToolButton#favoriteButton:hover,
QToolButton#favoriteButton:pressed,
QToolButton#favoriteButton:checked,
QToolButton#recentButton:hover,
QToolButton#recentButton:pressed,
QToolButton#recentButton:checked,
QWidget#topBarHost QToolButton#quickButton:hover,
QWidget#topBarHost QToolButton#quickButton:pressed,
QWidget#topBarHost QToolButton#quickButton:checked,
QWidget#topBarHost QToolButton#favoriteButton:hover,
QWidget#topBarHost QToolButton#favoriteButton:pressed,
QWidget#topBarHost QToolButton#favoriteButton:checked,
QWidget#topBarHost QToolButton#recentButton:hover,
QWidget#topBarHost QToolButton#recentButton:pressed,
QWidget#topBarHost QToolButton#recentButton:checked {
border-color: @text_accent;
}
QMenu,
QMenuBar QMenu,
QMenuBar::item:hover,
QMenuBar::item:selected,
QMenuBar::item:pressed {
border-color: @text_accent;
}
QMenuBar {
border-color: @border_subtle;
}
QComboBox QAbstractItemView,
QDialog QComboBox QAbstractItemView,
QListView#comboPopupView {
selection-background-color: @hover_bg;
selection-color: #F3FFF7;
}
/* Unified state matrix: end */







