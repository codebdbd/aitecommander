QWidget { color: #F5F1D6; }
QMainWindow {
background: #10170F;
}
QMainWindow > QFrame {
background: #10170F;
}
QWidget#LeftPanel[sphere="1"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #10170F, stop: 0.95 #10170F,
stop: 0.95 #1F5A2E, stop: 1 #1F5A2E
);
}
QWidget#LeftPanel[sphere="2"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #10170F, stop: 0.95 #10170F,
stop: 0.95 #7A2020, stop: 1 #7A2020
);
}
QWidget#LeftPanel[sphere="3"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #10170F, stop: 0.95 #10170F,
stop: 0.95 #6A5A16, stop: 1 #6A5A16
);
}
QWidget#LeftPanel[sphere="4"] {
background: qlineargradient(
x1: 0, y1: 0, x2: 0, y2: 1,
stop: 0 #10170F, stop: 0.95 #10170F,
stop: 0.95 #22513A, stop: 1 #22513A
);
}
