/* Dark theme color styles */

QWidget#LeftPanel {
    background: transparent;
}

QWidget#LeftPanel[sphere="1"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1A1F26, stop: 0.95 #1A1F26,
        stop: 0.95 #2E4066, stop: 1 #2E4066
    );
}

QWidget#LeftPanel[sphere="2"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1A1F26, stop: 0.95 #1A1F26,
        stop: 0.95 #6A2E44, stop: 1 #6A2E44
    );
}

QWidget#LeftPanel[sphere="3"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1A1F26, stop: 0.95 #1A1F26,
        stop: 0.95 #4A375A, stop: 1 #4A375A
    );
}

QWidget#LeftPanel[sphere="4"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1A1F26, stop: 0.95 #1A1F26,
        stop: 0.95 #2E5A52, stop: 1 #2E5A52
    );
}

QWidget#spheres_bar QToolButton {
    border-color: transparent;
}

QWidget#spheres_bar QToolButton:hover {
    border-color: #3A6EFF;
}

QWidget#spheres_bar QToolButton:checked {
    background: #1E2633;
    border-color: #3A6EFF;
}

QWidget#LeftPanel QToolButton {
    background: transparent;
}

QWidget#LeftPanel QToolButton:hover {
    background: #1E2633;
}

QMenu {
    color: #D1D6E0;
    background-color: #1E2633;
    border-color: #14191F;
}

QMenu::item {
    background-color: transparent;
    color: #D1D6E0;
}

QMenu::item:selected {
    background-color: #2E4066;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #5A6372;
    background-color: transparent;
}

QMenu::separator {
    background: #252D3A;
}

QMenu::item:hover {
    background-color: #2E4066;
    color: #FFFFFF;
}

QMenu::item:pressed {
    background-color: #3D507A;
}

QMenu::right-arrow {
    image: url(:/icons/right-arrow.svg);
}

QMenu::indicator:checked {
    background-color: #3A6EFF;
    border-color: #3A6EFF;
}

QTreeView {
    background-color: transparent;
}

QMenuBar {
    background-color: #1A1F26;
}

QMenuBar::item {
    background: transparent;
    color: #C9D1DA;
}

QMenuBar::item:selected {
    background: #252D3A;
    color: #FFFFFF;
}

QMenuBar::item:pressed {
    background: #2E4066;
}

QMenuBar QMenu {
    background-color: #1E2633;
    border-color: #252D3A;
}

QMainWindow {
    background-color: #1A1F26;
    color: #C9D1DA;
}

QWidget#topPanelContainer {
    background: #1A1F26;
}


QWidget#topPanelContainer QLineEdit {
    border-color: #252D3A;
}


QWidget#topPanelContainer QToolButton {
    border-color: transparent;
}

QPushButton {
    background-color: #252D3A;
    border-color: #2E4066;
}

QPushButton:hover {
    background-color: #2E4066;
}

QToolButton {
    background-color: #252D3A;
    border-color: #2E4066;
}

/* Category Tiles Styles */
QListWidget#categoryTiles {
    background: transparent;
    border: none;
}

QListWidget#categoryTiles::item {
    background: transparent;
    border: none;
}

QToolButton:hover {
    background-color: #2E4066;
    border-color: #3A6EFF;
}

QToolButton:pressed {
    background-color: #1E2633;
    border-color: #2E4066;
}

QToolButton:checked {
    background-color: #3A6EFF;
    border-color: #3A6EFF;
}

QLineEdit, QTextEdit, QComboBox, QSpinBox {
    background-color: #252D3A;
    border-color: #2E4066;
}

QComboBox QAbstractItemView {
    background-color: #252D3A;
    selection-background-color: #2E4066;
    border-color: #2E4066;
}

QHeaderView::section {
    background-color: #252D3A;
    border-right-color: rgb(71, 78, 110);
    color: #C9D1DA;
}

QLabel#pathLabel {
    color: #9EA9B7;
}

QTableWidget QTableCornerButton::section,
QTableWidget QTableCornerButton::section:first {
    background-color: #1E2633;
}

QTableWidget QTableCornerButton::section:alternate {
    background-color: #252D3A;
}

QTableWidget {
    alternate-background-color: #1E2633;
    gridline-color: transparent;
}

QTreeWidget {
    background-color: transparent;
}

QTreeWidget::item:selected,
QTableWidget::item:selected {
    background-color: #6A2E44;
    color: #FFFFFF;
}

QTreeWidget::item:hover {
    background-color: #252D3A;
}

QWidget[class="separator"] {
    background-color: #252D3A;
}

QStatusBar {
    border-top-color: #252D3A;
}

QWidget#bottomBarContainer {
    background-color: #252D3A;
    border-top-color: #252D3A;
    border-bottom-color: #252D3A;
}

#bottomBarContainer QPushButton {
    background-color: #2D3A4A;
    color: #fff;
}

#bottomBarContainer QPushButton:hover {
    background-color: #3A4A5A;
}

QWidget#favQuickSeparatorBefore,
QWidget#favQuickSeparatorAfter {
    min-width: 1px;
    max-width: 1px;
    width: 1px;
    min-height: 24px;
    background: #252D3A;
}

QWidget[class="vertical_separator"] {
    background-color: rgb(71, 78, 110);
}

QSplitter::handle {
    background: transparent;
}

#spheres_bar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1A1F26, stop: 0.95 #1A1F26,
        stop: 0.95 #1E2633, stop: 1 #1E2633
    );
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #1E2633;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #2E4066;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #3A6EFF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
}

QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical,
QScrollBar::left-arrow:horizontal, QScrollBar::right-arrow:horizontal {
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}