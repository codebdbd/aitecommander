/* Dark theme color styles */

/* QWidget#LeftPanel: фон и геометрия заданы в common.qss */

QWidget#LeftPanel[sphere="1"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1A1F26, stop: 0.95 #1A1F26,
        stop: 0.95 #2E4066, stop: 1 #2E4066
    );
}

QWidget#LeftPanel[sphere="2"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1A1F26, stop: 0.95 #1A1F26,
        stop: 0.95 #6A2E44, stop: 1 #6A2E44
    );
}

QWidget#LeftPanel[sphere="3"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1A1F26, stop: 0.95 #1A1F26,
        stop: 0.95 #4A375A, stop: 1 #4A375A
    );
}

QWidget#LeftPanel[sphere="4"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1A1F26, stop: 0.95 #1A1F26,
        stop: 0.95 #2E5A52, stop: 1 #2E5A52
    );
}

QWidget#spheres_bar QToolButton {
    border-color: transparent;
}

/* Усиленное правило hover: явно задаём border, чтобы перебить border:none */
QWidget#spheres_bar QToolButton:hover,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:hover {
    border-color: #0194F0;
}

QWidget#spheres_bar QToolButton:checked {
    background: #1E2633;
    border-color: #0194F0;
}

/* При наведении на активную кнопку показывать синюю рамку */
QWidget#spheres_bar QToolButton:checked:hover,
QWidget#LeftPanel QWidget#spheres_bar QToolButton:checked:hover {
    border-color: #0194F0;
}

/* Внутри LeftPanel активная кнопка сферы должна иметь такую же обводку, как hover */
QWidget#LeftPanel QWidget#spheres_bar QToolButton:checked {
    background: #1E2633;
    border-color: #0194F0;
}

/* QWidget#LeftPanel QToolButton: базовый фон задан в common.qss */

QWidget#LeftPanel QToolButton:hover {
    background: #1E2633;
}

/* Базовая рамка для кнопок в панели сфер, чтобы не было смещения при hover */
/* #spheres_bar buttons: геометрия перемещена в common.qss */

/* Обводка при наведении для QPushButton в панели сфер (если такие используются) */
#spheres_bar QPushButton:hover {
    border-color: #0194F0;
}

QMenu {
    color: #D1D6E0;
    background-color: #1E2633;
    border-color: #14191F;
}

QMenu::item {
    background-color: transparent;
    color: #D1D6E0;
}

QMenu::item:selected {
    background-color: #2E4066;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #5A6372;
    background-color: transparent;
}

QMenu::separator {
    background: #252D3A;
}

QMenu::item:hover {
    background-color: #2E4066;
    color: #FFFFFF;
}

QMenu::item:pressed {
    background-color: #3D507A;
}

/* right-arrow image moved to common.qss */

QMenu::indicator:checked {
    background-color: #3A6EFF;
    border-color: #3A6EFF;
}

/* QTreeView базовый фон задан в common.qss */

QMenuBar {
    background-color: #1A1F26;
}

QMenuBar::item {
    background: transparent;
    color: #C9D1DA;
}

QMenuBar::item:selected {
    background: #252D3A;
    color: #FFFFFF;
}

QMenuBar::item:pressed {
    background: #2E4066;
}

QMenuBar QMenu {
    background-color: #1E2633;
    border-color: #252D3A;
}

QMainWindow {
    background-color: #1A1F26;
    color: #C9D1DA;
}

QWidget#topPanelContainer {
    background: #1A1F26;
}

/* Обводка поиска при hover/focus в верхней панели */
QWidget#topPanelContainer QLineEdit:hover,
QWidget#topPanelContainer QLineEdit:focus {
    border-color: #0194F0;
}


QWidget#topPanelContainer QToolButton {
    border-color: transparent;
}

/* Обводка на всех кнопках верхней панели при hover (после базового правила) */
QWidget#topPanelContainer QToolButton:hover,
QWidget#topPanelContainer QPushButton:hover {
    border-color: #0194F0;
}

/* Обводка для активных (checked) кнопок верхней панели */
QWidget#topPanelContainer QToolButton:checked,
QWidget#topPanelContainer QPushButton:checked {
    border-color: #0194F0;
}

QPushButton {
    background-color: #252D3A;
    border-color: #2E4066;
}

QPushButton:hover {
    background-color: #2E4066;
    border-color: #0194F0;
}

QToolButton {
    background-color: #252D3A;
    border-color: #2E4066;
}

/* Category Tiles Styles */
/* Legacy selector kept for backward compatibility */
/* categoryTiles контейнер: геометрия в common.qss */

/* База item геометрии в common.qss */

/* New QListView-based tiles (IconMode) */
/* QListView#categoryTiles базовая геометрия в common.qss */

/* База item геометрии в common.qss */

/* Hover: синяя обводка и тёмный фон, как у сфер */
QListWidget#categoryTiles::item:hover,
QListView#categoryTiles::item:hover {
    background: #1E2633;
    border-color: #0194F0;
}

/* Selected: фиксируем такой же стиль, как у активной кнопки */
QListWidget#categoryTiles::item:selected,
QListView#categoryTiles::item:selected {
    background: #1E2633;
    border-color: #0194F0;
}

/* Selected + Hover: сохраняем синюю обводку */
QListWidget#categoryTiles::item:selected:hover,
QListView#categoryTiles::item:selected:hover {
    border-color: #0194F0;
}

QToolButton:hover {
    background-color: #2E4066;
    border-color: #0194F0;
}

QToolButton:pressed {
    background-color: #1E2633;
    border-color: #2E4066;
}

QToolButton:checked {
    background-color: #3A6EFF;
    border-color: #3A6EFF;
}

QLineEdit, QTextEdit, QComboBox, QSpinBox {
    background-color: #252D3A;
    border-color: #2E4066;
}



QComboBox QAbstractItemView {
    background-color: #252D3A;
    selection-background-color: #2E4066;
    border-color: #2E4066;
}

QHeaderView::section {
    background-color: #1A1F26;
    border-right-color: #252D3A; /* как горизонтальные сепараторы */
    color: #C9D1DA;
}

QTableView QHeaderView::section:horizontal {
    border-right-color: #252D3A; /* как горизонтальные сепараторы */
}
QTableView QHeaderView {
    border-bottom-color: #252D3A;
}

QLabel#pathLabel {
    color: #9EA9B7;
}

/* Corner для QTableView (corner принадлежит представлению) */
QTableView QTableCornerButton::section,
QTableView QTableCornerButton::section:first {
    background-color: #202731;
}
QTableView QTableCornerButton::section:alternate {
    background-color: #202731;
}

/* Вертикальные заголовки для QTableView (колонка цифр) */
QTableView QHeaderView::section:vertical {
    background-color: #202731;
}
QTableView QHeaderView:vertical {
    background-color: #202731;
}

QTableView {
    background-color: #2D2D2D;
    alternate-background-color: #1A1F26;
    gridline-color: transparent;
}

/* TreeView background: задан в common.qss */

QTreeView::item:selected,
QTableView::item:selected {
    background-color: #6A2E44;
    color: #FFFFFF;
}

QTreeView::item:!selected:hover {
    background-color: #444444;
}

QTreeView::item:!selected:hover {
    background-color: #444444;
}


QWidget[class="separator"] {
    background-color: #252D3A;
}

QStatusBar {
    background-color: #202731;
}

/* Менее контрастные надписи справа в статус-баре */
QStatusBar QLabel#dbStatusLabel,
QStatusBar QLabel#linksCountLabel {
    color: #7E8896; /* чуть бледнее, чем #9EA9B7 у pathLabel */
    font-weight: normal;
}

QWidget#bottomBarContainer {
    background-color: #1A1F26;
    border-top-color: #1A1F26;
    border-bottom-color: #1A1F26;
}

#bottomBarContainer QPushButton {
    color: #fff;
    /* Разделитель справа между кнопками — только цвет */
    border-right-color: #252D3A;
}

/* У последней кнопки убираем разделитель справа */
/* geometry for last button separator is defined in common.qss */

/* Обводка только при наведении */
#bottomBarContainer QPushButton:hover {
    border-color: #0194F0;
}

/* Focus outline for dialog inputs */
QDialog QLineEdit:focus,
QDialog QTextEdit:focus,
QDialog QPlainTextEdit:focus,
QDialog QComboBox:focus,
QDialog QSpinBox:focus,
QDialog QDoubleSpinBox:focus,
QDialog QDateEdit:focus,
QDialog QTimeEdit:focus {
    border-color: #0194F0;
}

/* Dialog buttons: keyboard focus outline (Tab navigation) */
QDialog QPushButton:focus,
QDialog QToolButton:focus {
    border-color: #0194F0;
}

/* Disabled dialog buttons: gray background, keep existing borders */
QDialog QPushButton:disabled,
QDialog QToolButton:disabled {
    background: #3A3A3A; /* gray for dark theme */
}
QDialog QPushButton:disabled:hover,
QDialog QToolButton:disabled:hover {
    background: #3A3A3A;
}

 


/* QFocusFrame базовые нейтрали в common.qss */

/* Keyboard focus outline (Tab navigation) */
QDialog QCheckBox:focus {
    border-color: #0194F0;
}

/* =========================
   Dialog combobox dropdown (popup list)
   ========================= */
QDialog QComboBox QAbstractItemView {
    border-color: #2A2F3A;
    background: #151A22;
}

/* Item geometry настроена в common.qss */

/* Selected same as table/tree selected */
QDialog QComboBox QAbstractItemView::item:selected {
    background-color: #6A2E44;
    color: #FFFFFF;
}

/* Hover — нейтральная тёмная подсветка в духе темы */
QDialog QComboBox QAbstractItemView::item:hover {
    background-color: #252D3A;
}

/* Default buttons: show border only when focused; remove system dotted outline */
QDialog QPushButton:default:focus,
QDialog QPushButton:autoDefault:focus {
    border-color: #0194F0;
}

/* Link type buttons (text under icon) — height by content with 8px paddings */
/* linkTypeBtn размеры перенесены в common.qss */

/* Match spheres bar behavior for link type buttons */
/* linkTypeBtn база перенесена в common.qss */
QDialog QToolButton#linkTypeBtn:hover {
    /* Same hover outline and hover background as spheres */
    border-color: #0194F0;
    background: #1E2633;
}
QDialog QToolButton#linkTypeBtn:checked {
    /* Active state matches spheres: dark bg + blue border */
    background: #1E2633;
    border-color: #0194F0;
}
QDialog QToolButton#linkTypeBtn:checked:hover {
    /* Keep blue outline on hover for active */
    border-color: #0194F0;
}

/* Скрываем вертикальные сепараторы в верхнем тулбаре */
/* Сепараторы скрываются и фон задаётся в common.qss */

/* На всякий случай: делаем вертикальные сепараторы невидимыми */
/* vertical_separator геометрия/фон — в common.qss */

/* QSplitter::handle фон — в common.qss */

#spheres_bar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1A1F26, stop: 0.95 #1A1F26,
        stop: 0.95 #1E2633, stop: 1 #1E2633
    );
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #1E2633;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #2E4066;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #0194F0;
}