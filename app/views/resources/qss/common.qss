/* ===============================================================
   COMMON.QSS — Общие стили для всех тем (dark/light)
   Здесь задаются нейтральные (без цветов) базовые параметры:
   - геометрия (отступы, ширины, высоты, радиусы)
   - видимость рамок (но не их цвет)
   - общая типографика (без вмешательства в системный размер шрифта)

   Цвета и конкретные оттенки переопределяются в файлах темы:
   - dark.qss, light.qss

   Важно: специфичные функции UI (верхняя панель, панели избранного/недавних,
   панель сфер, таблицы, меню) имеют отдельные блоки ниже с комментариями.

   Структура файла (навигация по разделам):
   1) Левая панель и панель сфер (контейнеры/кнопки)
   2) Меню (QMenu)
   3) Меню-бар (QMenuBar)
   4) Верхняя панель (контейнеры, кнопки, поле поиска)
   5) Базовые кнопки (вне верхней панели)
   6) QToolButton (вне верхней панели)
   7) Поля ввода (общие) и выпадающие списки
   8) Заголовки таблиц/деревьев (QHeaderView)
   9) Статус-бар и нижняя панель
  10) Разделители и сплиттеры
  11) Контейнер панели сфер
  12) Скролл-области и скроллбары
  13) Категорийные плитки
  14) Нижняя панель: кнопки
  15) Диалоги (кнопки/поля/чекбоксы)
  16) База для всех полей и чекбоксов (вне диалогов)
  17) Служебные элементы и фокус-фрейм
   =============================================================== */
/* Common styles for all themes */

/* ---------------------------------------------------------------
   ИНДЕКС НАСТРАИВАЕМЫХ ПАРАМЕТРОВ (из app_config.json -> ui)
   - menu_font_size, menu_icon_size, menu_indicator_size
   - menubar_font_size, menubar_item_height
   - top_panel_container_height, top_bar_margins
   - scrollbar_width, scrollbar_height
   - tree_item_height, table_item_height
   - separator_height
   - splitter_handle_width
   - spheres_bar_height, spheres_layout_margins, spheres_bar_margin_left/right
   - default_font_size (общая типографика; может применяться из кода)
   - top_panel_icon_size, quick_add_button_size (размеры кнопок/иконок верхней панели — задаются из кода)
   Примечание: часть параметров применяется из Python-кода (layout spacing/margins,
   фиксированные размеры виджетов) и здесь только документируется, чтобы было ясно,
   где искать настройку.
   --------------------------------------------------------------- */

/* 1) Левая панель (контейнер дерева + панель сфер) */
QWidget#LeftPanel {
    border: none;
    background: transparent;
}

/* 1.1) Кнопки на панели сфер (только рамка, без цвета). Цвет задаёт тема */
QWidget#spheres_bar QToolButton {
    border: 1px solid;
    border-radius: 4px;
    padding: 6px;
}

/* Сферы: на hover/pressed/checked оставляем ту же геометрию рамки (цвет в теме) */
QWidget#spheres_bar QToolButton:hover,
QWidget#spheres_bar QToolButton:pressed,
QWidget#spheres_bar QToolButton:checked {
    border: 1px solid;
    border-color: transparent;
}

/* 1.2) Любые QToolButton внутри левой панели: базово без рамки (цвет добавит тема) */
QWidget#LeftPanel QToolButton {
    border: none;
}

/* 1.3) Исключение: кнопки панели сфер внутри LeftPanel должны иметь рамку */
QWidget#LeftPanel QWidget#spheres_bar QToolButton {
    border: 1px solid;
    border-color: transparent; /* цвет задаст тема (hover/checked) */
    border-radius: 4px;
}

/* =========================
   2) Меню (контекстные/выпадающие)
   Настройка из конфигурации:
   - ui.menu_font_size
   - ui.menu_icon_size
   - ui.menu_indicator_size
   ========================= */
QMenu {
    border-radius: 0px;
    padding: 0; /* без дополнительного нижнего отступа */
    font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    /* font-size: устанавливается динамически из config_loader.get_menu_font_size() */
}

QMenu::item {
    padding: 0 12px 0 16px; /* без вертикальных отступов */
    margin: 0 0px;
    border-radius: 0px;
    min-width: 180px;
    height: 32px; /* жёсткая высота строки меню */
}

QMenu::icon {
    padding-left: 16px;
    /* width/height: из ui.menu_icon_size (config_loader.get_menu_icon_size()) */
}

QMenu::separator {
    height: 1px;
    margin: 0; /* без отступов до/после разделителя */
    padding: 0; /* без горизонтального внутреннего отступа */
}

/* Use platform default submenu arrow; disable missing resource reference */
QMenu::right-arrow {
    /* image: url(:/icons/right-arrow.svg); */
    image: none;
    width: 10px;
    height: 10px;
    margin-right: 4px;
}

QMenu::icon:disabled {
    opacity: 0.5;
}

QMenu::item:!has-icon {
    padding-left: 32px;
}

QMenu::indicator {
    /* width/height: из ui.menu_indicator_size (config_loader.get_menu_indicator_size()) */
    margin-left: 4px;
}

QMenu::indicator:checked {
    border-radius: 3px;
}

 

/* =========================
   3) Меню-бар (верхнее системное меню)
   Настройка из конфигурации:
   - ui.menubar_font_size
   - ui.menubar_item_height
   ========================= */
QMenuBar {
    padding: 0;
    border-top: 1px solid;
    border-bottom: 1px solid;
    border-left: none;
    border-right: none;
    border-radius: 0;
    spacing: 0;
    margin: 0;
}

QMenuBar::item {
    padding: 4px 10px;
    border-radius: 0;
    margin: 0;
    /* font-size: из ui.menubar_font_size; min-height: из ui.menubar_item_height */
    font-weight: normal;
}

QMenuBar QMenu {
    margin-top: 2px;
    padding: 0; /* без верх/низ отступов, как у контекстного меню */
    border-radius: 0;
}

QMenuBar QMenu::item {
    padding: 0 24px 0 8px; /* без вертикальных отступов */
    min-width: 120px;
    height: 32px; /* жёсткая высота пункта в выпадающем меню-баре */
}



/* =========================
   4) Верхняя панель — фоновые фреймы панелей (без цветов)
   Доп. настройка из кода:
   - ui.top_panel_container_height (fixedHeight контейнера)
   - ui.top_bar_margins (отступы layout сверху/снизу/слева/справа)
   - ui.layout.spacing.top_bar (расстояние между элементами тулбара)
   - ui.top_panel_icon_size, ui.quick_add_button_size (размеры кнопок/иконок)
   ========================= */
QFrame#favoritesPanelBg,
QFrame#quickAddPanelBg {
    border-radius: 0;
    /* min-height устанавливается динамически из config_loader.get_top_panel_button_size() */
    margin: 0;
    padding: 0;
}

/* Recent: без дополнительного внутреннего отступа, чтобы ширина считалась точно */
QFrame#recentPanelBg {
    border-radius: 0;
    margin: 0;
    padding: 0;
}

/* Поле поиска в верхней панели — размеры/внутренние отступы см. ниже (единый блок с border) */

/* Контейнер верхней панели (текущий: topBarHost) и его прямые дети — без внешних отступов
   Примечание: высота контейнера задаётся из кода (ui.top_bar_height | ui.top_panel_container_height b/c),
   отступы/spacing layout — из кода (ui.top_bar_margins, ui.layout.spacing.top_bar) */
QWidget#topBarHost {
    margin: 0;
    padding: 0;
}

QWidget#topBarHost > QWidget {
    margin: 0;
    padding: 0;
}

QWidget#topBarHost QToolButton {
    border: 1px solid;
    border-color: transparent;
    border-radius: 4px;
    padding: 0;
    margin: 0;
    min-height: 32px;
    max-height: 32px;
    /* Размеры кнопок и иконок верхней панели выставляются из кода
       (например, ui.top_panel_icon_size, ui.quick_add_button_size) */
}

QWidget#topBarHost QToolButton:hover,
QWidget#topBarHost QToolButton:pressed,
QWidget#topBarHost QToolButton:checked {
    border: 1px solid;
    border-color: transparent;
}

/* Кнопки верхней панели типа QPushButton — приводим к тем же размерам */
QWidget#topBarHost QPushButton {
    border: 1px solid;
    border-color: transparent;
    border-radius: 8px;
    padding: 0;
    margin: 0;
    min-height: 32px;
    max-height: 32px;
}
QWidget#topBarHost QPushButton:hover,
QWidget#topBarHost QPushButton:pressed,
QWidget#topBarHost QPushButton:checked {
    border: 1px solid;
    border-color: transparent;
}

/* Поле поиска — базовая рамка без задания радиуса (радиус задаётся ТОЛЬКО в QLineEdit#mainSearch) */
QWidget#topBarHost QLineEdit {
    border: 1px solid;
    border-color: transparent;
    min-height: 32px;
    max-height: 32px;
    padding: 0 8px;
}

/* Специфический стиль поискового поля (перебивает общие и темовые правила) */
QLineEdit#mainSearch {
    border-radius: 4px;
    min-height: 32px;
    max-height: 32px;
    padding: 0 8px;
    padding-top: 1px; /* поднимаем текст визуально, не меняя общую высоту */
}
QLineEdit#mainSearch:hover,
QLineEdit#mainSearch:focus {
    border: 1px solid;
    border-color: transparent;
}

/* =========================
   5) Базовые кнопки (вне верхней панели)
   ========================= */
QPushButton {
    border: 1px solid;
    border-color: transparent; /* цвет задаст тема */
    border-radius: 8px;
    padding: 4px 8px;
}

QPushButton:pressed {
    border-style: inset;
}



/* =========================
   6) QToolButton (общие правила вне верхней панели)
   ========================= */
QToolButton {
    border: 1px solid;
    border-color: transparent; /* цвет задаст тема */
    padding: 4px 8px;
    border-radius: 8px;
}

QToolButton:hover {
    border: 1px solid;
}

QToolButton:pressed {
    border: 1px solid;
}

QToolButton:checked {
    border: 1px solid;
}

/* 7) Поля ввода (общие) */
QLineEdit, QTextEdit, QComboBox, QSpinBox {
    border: 1px solid;
    border-radius: 0;
    padding: 2px;
}

/* 7.0a) Дополнительный левый отступ у текста в QComboBox,
   чтобы не прилипал к левой рамке (цвет задаёт тема) */
QComboBox {
    padding-left: 8px;
    padding-right: 22px; /* резерв под стрелку справа, чтобы текст не налезал */
}



/* 7.1) Выпадающий список у QComboBox */
QComboBox QAbstractItemView {
    border: 1px solid;
    border-radius: 0;
}

QComboBox QAbstractItemView::item {
    min-height: 32px;
    padding-left: 4px;
}

/* Убираем пунктирную обводку фокуса/наведения в выпадающем списке */
QComboBox QAbstractItemView:focus { outline: none; }
QComboBox QAbstractItemView::item:focus { outline: none; }
QComboBox QAbstractItemView::item:hover { outline: none; }

/* Плоский дропдаун у QComboBox (везде) */
QComboBox::drop-down {
    border: none;
    background: transparent;
    border-left: none;
    border-radius: 0;
    padding: 0;
    margin: 0;
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px; /* больше места под более крупную стрелку */
}

/* Геометрия иконки стрелки комбобокса — единая для всех тем */
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    margin-right: 6px;
    margin-top: 1px;
}
/* Стрелка комбобокса: изображение перенесено из темы в common */
QComboBox::down-arrow {
    image: url("app/views/resources/ui_icons/dark/chevron_down.svg");
}
QDialog QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    margin-right: 6px;
    margin-top: 1px;
}
/* Диалог: стрелка комбобокса — изображение перенесено из темы в common */
QDialog QComboBox::down-arrow {
    image: url("app/views/resources/ui_icons/dark/chevron_down.svg");
}

/* Плоский дропдаун у QComboBox в диалогах */
QDialog QComboBox::drop-down {
    border: none;
    background: transparent;
    border-left: none;
    border-radius: 0;
    padding: 0;
    margin: 0;
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px; /* больше места под более крупную стрелку */
}

/* 8) Заголовки колонок в таблицах/деревьях */
QHeaderView::section {
    border-right: 1px solid;
    border-right-color: transparent; /* цвет задаст тема */
    padding: 4px;
}



QHeaderView::section:last {
    border-right: none;
}

/* Не даём системе делать жирным при активном/нажатом состоянии и сохраняем размер */
QHeaderView::section:pressed,
QHeaderView::section:hover,
QHeaderView::section:checked {
    /* поведение границ/фона задаётся темой; шрифт управляется на QHeaderView */
}

/* Правильное место для шрифта заголовка — сам QHeaderView */
QHeaderView {
    font: 11pt;
    font-weight: normal;
}
/* Повышенная специфичность для таблиц и деревьев */
QTableView QHeaderView,
QTreeView QHeaderView {
    font: 11pt;
    font-weight: normal;
}

/* Лейбл пути в статус-баре */
QLabel#pathLabel {
    font-weight: normal;
    padding: 2px 8px;
}

QTableView QTableCornerButton::section,
QTableView QTableCornerButton::section:first {
    border: none;
    border-right: 1px solid;
    border-bottom: 1px solid;
}

QTableView QTableCornerButton::section:alternate {
}

/* Таблицы/деревья — базовая раскладка без рамок (цвета — в темах) */
QTableView {
    border: none;
    border-radius: 0;
    outline: none;
}

QTableView::item {
    border: none;
    border-radius: 0px;
}



QTreeView::item:selected,
QTableView::item:selected {
    border-radius: 0px;
}

QTreeView::item:hover {
    border-radius: 0px;
}

/* Дефолт на TreeView — фон прозрачен, цвета задаются темами */
QTreeView { background: transparent; }

/* QTreeView item geometry: высота устанавливается из конфигурации на уровне кода
   (config_loader.get_tree_item_height()) */
QTreeView::item {
    /* min-height/height настраиваются из кода */
}

/* Горизонтальные/вертикальные разделители (фон/цвета задаются темами)
   Высота задаётся из конфигурации: ui.separator_height (app_config.json: ui.separator.height) */
QWidget[class="separator"] {
    border: none;
    min-height: 1px;
    max-height: 1px;
    margin: 0;
    padding: 0;
}

/* =========================
   9) Статус-бар и нижняя панель (контейнер)
   ========================= */
QStatusBar {
    border-top: 1px solid;
    border-top-color: transparent;
}

QStatusBar::item {
    border: none;
}

/* Нижняя панель (контейнер) */
QWidget#bottomBarContainer {
    border: none !important;
    /* Геометрия контейнера: без внешних/внутренних отступов */
    margin: 0;
    padding: 0;
}

/* =========================
   10) Разделители и сплиттеры
   ========================= */
/* Тонкие вертикальные разделители в верхней панели
   Геометрия (width/height) задаётся ТОЛЬКО из кода через app_config:
   - ui.separator_width, ui.separator_height */
QWidget#favQuickSeparatorBefore,
QWidget#favQuickSeparatorAfter {
    /* Generic menu geometry and borders */
}

QMenu {
    border-style: solid;
    border-width: 1px; /* ширина линии задаётся здесь (общая); цвет — в теме */
}

/* Выпадающие меню главного меню: без зазора от меню-бара */
QMenuBar QMenu {
    margin-top: 0px;
}

/* Универсальный вертикальный разделитель (геометрия задаётся из кода при создании) */
QWidget[class="vertical_separator"] {}

/* Ползунок сплиттера (толщина/геометрия)
   Толщина задаётся из кода: ui.splitter_handle_width */
QSplitter::handle {}

QSplitter::handle:horizontal {
    margin: 0;
    padding: 0;
}

QSplitter::handle:vertical {
    margin: 0;
    padding: 0;
}

 

/* 11) Панель сфер — контейнер (геометрия и скругления без цветов)
   Настройка из конфигурации (применяется из кода):
   - ui.spheres_bar_height
   - ui.spheres_layout_margins
   - ui.spheres_bar_margin_left, ui.spheres_bar_margin_right */
#spheres_bar {
    border: none;
    margin-bottom: 0;
    border-radius: 0;
    padding: 0;
}

/* 12) Скролл-области и скроллбары — нейтральные правила */
QAbstractScrollArea {
    border: none;
}

/* 12.1) Скроллбар вертикальный (размеры — из конфигурации)
   Ширина: ui.scrollbar_width */
QScrollBar:vertical {
    border: none;
    /* width устанавливается динамически из config_loader.get_scrollbar_width() */
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    min-height: 20px;
}



QScrollBar::add-line:vertical {
    height: 0px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
    height: 0px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

/* 12.2) Скроллбар горизонтальный (размеры — из конфигурации)
   Высота: ui.scrollbar_height */
QScrollBar:horizontal {
    border: none;
    /* height устанавливается динамически из config_loader.get_scrollbar_height() */
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:horizontal {
    min-width: 20px;
}

QScrollBar::add-line:horizontal {
    width: 0px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
    width: 0px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

 

/* =========================
   13) Категорийные плитки (общая геометрия)
   ========================= */
QListWidget#categoryTiles { border: none; background: transparent; }
QListWidget#categoryTiles::item {
    background: transparent;
    border: 1px solid;
    border-color: transparent;
    border-radius: 8px;
}
QListView#categoryTiles { border: none; background: transparent; }
QListView#categoryTiles::item {
    background: transparent;
    border: 1px solid;
    border-color: transparent;
    border-radius: 8px;
}

QListWidget#categoryTiles::item:hover,
QListView#categoryTiles::item:hover,
QWidget#spheres_bar QToolButton:hover,
QWidget#spheres_bar QToolButton:pressed,
QWidget#spheres_bar QToolButton:checked,
QWidget#topBarHost QToolButton:hover,
QWidget#topBarHost QToolButton:pressed,
QWidget#topBarHost QToolButton:checked,
QLineEdit#mainSearch:hover,
QLineEdit#mainSearch:focus,
QDialog QToolButton#linkTypeBtn:hover,
QDialog QToolButton#linkTypeBtn:pressed,
QDialog QToolButton#linkTypeBtn:checked {
    border: 1px solid;
    border-color: transparent;
}

/* =========================
   14) Нижняя панель: кнопки (геометрия)
   ========================= */
QWidget#bottomBarContainer QPushButton {
    background: transparent;
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    border-right: 1px solid;
    border-right-color: transparent;
}
QWidget#bottomBarContainer QPushButton[last="1"] { border-right: none; }

/* =========================
   15) Диалоги — базовые нейтральные правила
   ========================= */
QDialog QPushButton {
    /* base border presence, radius; цвет задаст тема */
    border: 1px solid;
    border-color: transparent;
    border-radius: 4px;
    outline: none;
    min-height: 32px;
    max-height: 32px;
}
QDialog QToolButton {
    /* base border presence, radius; цвет задаст тема */
    border: 1px solid;
    border-color: transparent;
    border-radius: 8px;
    outline: none;
}
/* Плитки выбора типа ссылок: скругление 4px */
QDialog QToolButton#linkTypeBtn {
    border-radius: 4px;
}
/* Диалоговые кнопки: при hover/pressed/checked толщина рамки неизменна */
QDialog QPushButton:hover,
QDialog QPushButton:pressed,
QDialog QPushButton:checked,
QDialog QToolButton:hover,
QDialog QToolButton:pressed,
QDialog QToolButton:checked {
    border: 1px solid;
    border-color: transparent;
}
/* Специфика кнопок выбора типа ссылки: размеры и фон без цветов */
QDialog QToolButton#linkTypeBtn {
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 6px;
    padding-right: 6px;
    margin: 0;
    background: transparent;
}
QDialog QLineEdit,
QDialog QTextEdit,
QDialog QPlainTextEdit,
QDialog QComboBox,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QDateEdit,
QDialog QTimeEdit {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}

/* 15.0a) Такой же левый отступ у QDialog QComboBox */
QDialog QComboBox {
    padding-left: 8px;
    padding-right: 22px; /* резерв под стрелку справа, чтобы текст не налезал */
}

/* 15.0b) Единая высота 32px для однострочных полей в диалогах */
QDialog QLineEdit,
QDialog QComboBox,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QDateEdit,
QDialog QTimeEdit {
    min-height: 32px;
    max-height: 32px;
}

/* 15.0c) Горизонтальные отступы текста у QLineEdit в диалогах */
QDialog QLineEdit {
    padding: 0 8px;
}

/* 16) База для всех полей (вне диалогов) — рамка присутствует, но прозрачная */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
}
QDialog QCheckBox {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    outline: none;
}
QDialog QCheckBox::indicator,
QDialog QCheckBox::indicator:focus { outline: none; }

/* 16.1) База для всех чекбоксов (вне диалогов) — рамка присутствует, но прозрачная */
QCheckBox {
    border: 1px solid;
    border-color: transparent;
    border-radius: 0;
    outline: none;
}

/* =========================
   17) Служебные элементы и фокус-фрейм
   ========================= */
QWidget#LeftPanel QToolButton { background: transparent; }
QWidget#favQuickSeparatorBefore,
QWidget#favQuickSeparatorAfter { background: transparent; }
QWidget[class="vertical_separator"] { background-color: transparent; }
QSplitter::handle { background: transparent; }

/* Скроллбар: нейтральные отключения фона у стрелок/псевдостраниц */
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { background: none; }
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical,
QScrollBar::left-arrow:horizontal, QScrollBar::right-arrow:horizontal { background: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* Убираем системную пунктирную рамку фокуса */
QFocusFrame { border: 0px; outline: none; background: transparent; }