}
QCheckBox::indicator,
QDialog QCheckBox::indicator {
border-color: #374352;
background: #11151B;
}
QCheckBox::indicator:hover,
QDialog QCheckBox::indicator:hover {
border-color: #74D9E7;
}
QCheckBox::indicator:checked,
QDialog QCheckBox::indicator:checked {
background: #74D9E7;
border-color: #74D9E7;
image: url(":/icons/dark/check.svg");
}
QCheckBox::indicator:disabled,
QDialog QCheckBox::indicator:disabled {
border-color: #374352;
background: #1F2732;
}
QDialog QCheckBox:focus {
border-color: #74D9E7;
}
QDialog QComboBox QAbstractItemView,
QFrame#comboPopupContainer,
QListView#comboPopupView {
border-color: #374352;
background: #1C2531;
}
QComboBox::down-arrow,
QDialog QComboBox::down-arrow {
