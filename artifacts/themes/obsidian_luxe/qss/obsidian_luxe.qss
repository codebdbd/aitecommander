color: #FFFFFF;
}
QComboBox QAbstractItemView::item:hover,
QDialog QComboBox QAbstractItemView::item:hover,
QListView#comboPopupView::item:hover {
background-color: #35546B;
}
QDialog QPushButton:default:focus,
QDialog QPushButton:autoDefault:focus {
