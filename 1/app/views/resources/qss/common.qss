/* Common styles for all themes */

QWidget#LeftPanel {
    border: none;
}

QWidget#spheres_bar QToolButton {
    border: 2px solid;
}

QWidget#LeftPanel QToolButton {
    border: none;
}

QMenu {
    border-radius: 0px;
    padding: 0 0 6px 0;
    padding-top: 0;
    font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    /* font-size: устанавливается динамически из config_loader.get_menu_font_size() */
}

QMenu::item {
    padding: 8px 12px 8px 16px;
    margin: 0 0px;
    border-radius: 0px;
    min-width: 180px;
    min-height: 28px;
}

QMenu::icon {
    padding-left: 16px;
    /* width и height устанавливаются динамически из config_loader.get_menu_icon_size() */
}

QMenu::separator {
    height: 1px;
    margin: 6px 0;
    padding: 0 8px;
}

QMenu::right-arrow {
    width: 10px;
    height: 10px;
    margin-right: 4px;
}

QMenu::icon:disabled {
    opacity: 0.5;
}

QMenu::item:!has-icon {
    padding-left: 32px;
}

QMenu::indicator {
    /* width и height устанавливаются динамически из config_loader.get_menu_indicator_size() */
    margin-left: 4px;
}

QMenu::indicator:checked {
    border-radius: 3px;
}

QTreeView {
}

QMenuBar {
    padding: 0;
    border: none;
    border-radius: 0;
    spacing: 0;
    margin: 0;
}

QMenuBar::item {
    padding: 4px 10px;
    border-radius: 0;
    margin: 0;
    /* font-size и min-height устанавливаются динамически из config_loader */
    font-weight: normal;
}

QMenuBar QMenu {
    margin-top: 2px;
    padding: 2px 0;
    border-radius: 0;
}

QMenuBar QMenu::item {
    padding: 4px 24px 4px 8px;
    min-width: 120px;
    min-height: 24px;
}

QWidget {
    font-family: "Segoe UI", sans-serif;
}

/* --- Top Panel Backgrounds (no colors) --- */
QFrame#favPanelBg,
QFrame#recentPanelBg,
QFrame#quickAddPanelBg {
    border-radius: 0;
    /* min-height устанавливается динамически из config_loader.get_top_panel_button_size() */
    margin: 0;
    padding: 0 8px;
}

QWidget#topPanelContainer QLineEdit {
    border-radius: 0;
    min-height: 32px;
    max-height: 32px;
    margin: 0;
    padding: 0 8px;
    vertical-align: middle;
}

QWidget#topPanelContainer {
    margin: 0;
    padding: 0;
}

QWidget#topPanelContainer > QWidget {
    margin: 0;
    padding: 0;
}

QWidget#topPanelContainer QToolButton {
    border: none;
    border-radius: 6px;
    padding: 0;
    margin: 0;
    min-height: 32px;
    max-height: 32px;
}

QWidget#topPanelContainer QPushButton {
    border: none;
    border-radius: 6px;
    padding: 0;
    margin: 0;
    min-height: 32px;
    max-height: 32px;
}

QWidget#topPanelContainer QLineEdit {
    border: 1px solid;
    border-radius: 0;
    min-height: 32px;
    max-height: 32px;
    padding: 0 8px;
}

/* Специфический стиль поискового поля: фиксируем высоту под 32px (как у кнопок) */
QLineEdit#mainSearch {
    border-radius: 0;
    min-height: 32px;
    max-height: 32px;
}

QPushButton {
    border: 1px solid;
    border-radius: 4px;
    padding: 4px 8px;
}

QPushButton:pressed {
    border-style: inset;
}

QToolButton {
    border: 1px solid;
    padding: 4px 8px;
    border-radius: 4px;
}

QToolButton:hover {
    border: 1px solid;
}

QToolButton:pressed {
    border: 1px solid;
}

QToolButton:checked {
    border: 1px solid;
}

QLineEdit, QTextEdit, QComboBox, QSpinBox {
    border: 1px solid;
    border-radius: 0;
    padding: 2px;
}

QComboBox QAbstractItemView {
    border: 1px solid;
    border-radius: 0;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding-left: 4px;
}

QHeaderView::section {
    border-right: 1px solid;
    padding: 4px;
}

QHeaderView::section:last {
    border-right: none;
}

QLabel#pathLabel {
    font-weight: normal;
    padding: 2px 8px;
}

QTableWidget QTableCornerButton::section,
QTableWidget QTableCornerButton::section:first {
}

QTableWidget QTableCornerButton::section:alternate {
}

QTableWidget {
    border: none;
    border-radius: 0;
    outline: none;
}

QTableWidget::item {
    border: none;
    border-radius: 0px;
}

QTreeWidget::item:selected,
QTableWidget::item:selected {
    border-radius: 0px;
}

QTreeWidget::item:hover {
    border-radius: 0px;
}

QWidget[class="separator"] {
    border: none;
    min-height: 1px;
    max-height: 1px;
    margin: 0;
    padding: 0;
}

QStatusBar {
    border-top: 1px solid;
}

QStatusBar::item {
    border: none;
}

QWidget#bottomBarContainer {
    border: none !important;
    border-top: 1px solid;
    border-bottom: 1px solid;
}

QWidget#favQuickSeparatorBefore,
QWidget#favQuickSeparatorAfter {
    min-width: 1px;
    max-width: 1px;
    width: 1px;
    /* min-height устанавливается динамически из config_loader.get_separator_height() */
}

QWidget[class="vertical_separator"] {
    min-width: 1px;
    max-width: 1px;
}

QSplitter::handle {
    width: 1px;
}

QSplitter::handle:horizontal {
    margin: 0;
    padding: 0;
}

QSplitter::handle:vertical {
    margin: 0;
    padding: 0;
}

QTreeWidget::item {
    /* min-height устанавливается динамически из config_loader.get_table_item_height() */
}

#spheres_bar {
    border: none;
    margin-bottom: 0;
    border-radius: 0;
    padding: 0;
}

QAbstractScrollArea {
    border: none;
}

QScrollBar:vertical {
    border: none;
    /* width устанавливается динамически из config_loader.get_scrollbar_width() */
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    min-height: 20px;
}



QScrollBar::add-line:vertical {
    height: 0px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
    height: 0px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar:horizontal {
    border: none;
    /* height устанавливается динамически из config_loader.get_scrollbar_height() */
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:horizontal {
    min-width: 20px;
}

QScrollBar::add-line:horizontal {
    width: 0px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
    width: 0px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QTreeView::item {
    /* height устанавливается динамически из config_loader.get_tree_item_height() */
}