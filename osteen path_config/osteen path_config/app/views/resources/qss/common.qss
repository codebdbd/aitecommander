/* ===============================================================
   COMMON.QSS — Общие стили для всех тем (dark/light)
   Здесь задаются нейтральные (без цветов) базовые параметры:
   - геометрия (отступы, ширины, высоты, радиусы)
   - видимость рамок (но не их цвет)
   - общая типографика

   Цвета и конкретные оттенки переопределяются в файлах темы:
   - dark.qss, light.qss

   Важно: специфичные функции UI (верхняя панель, панели избранного/недавних,
   панель сфер, таблицы, меню) имеют отдельные блоки ниже с комментариями.
   =============================================================== */
/* Common styles for all themes */

/* ---------------------------------------------------------------
   ИНДЕКС НАСТРАИВАЕМЫХ ПАРАМЕТРОВ (из app_config.json -> ui)
   - menu_font_size, menu_icon_size, menu_indicator_size
   - menubar_font_size, menubar_item_height
   - top_panel_container_height, top_bar_margins
   - scrollbar_width, scrollbar_height
   - tree_item_height, table_item_height
   - separator_height
   - splitter_handle_width
   - spheres_bar_height, spheres_layout_margins, spheres_bar_margin_left/right
   - default_font_size (общая типографика; может применяться из кода)
   - top_panel_icon_size, quick_button_size (размеры кнопок/иконок верхней панели — задаются из кода)
   Примечание: часть параметров применяется из Python-кода (layout spacing/margins,
   фиксированные размеры виджетов) и здесь только документируется, чтобы было ясно,
   где искать настройку.
   --------------------------------------------------------------- */

/* Левая панель (контейнер дерева + панель сфер) */
QWidget#LeftPanel {
    border: none;
}

/* Кнопки на панели сфер (только рамка, без цвета). Цвет задаёт тема */
QWidget#spheres_bar QToolButton {
    border: 2px solid;
}

/* Любые QToolButton внутри левой панели: базово без рамки (цвет добавит тема) */
QWidget#LeftPanel QToolButton {
    border: none;
}

/* =========================
   Меню (контекстные/выпадающие)
   Настройка из конфигурации:
   - ui.menu_font_size
   - ui.menu_icon_size
   - ui.menu_indicator_size
   ========================= */
QMenu {
    border-radius: 0px;
    padding: 0 0 6px 0;
    padding-top: 0;
    font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    /* font-size: устанавливается динамически из config_loader.get_menu_font_size() */
}

QMenu::item {
    padding: 8px 12px 8px 16px;
    margin: 0 0px;
    border-radius: 0px;
    min-width: 180px;
    min-height: 28px;
}

QMenu::icon {
    padding-left: 16px;
    /* width/height: из ui.menu_icon_size (config_loader.get_menu_icon_size()) */
}

QMenu::separator {
    height: 1px;
    margin: 6px 0;
    padding: 0 8px;
}

QMenu::right-arrow {
    width: 10px;
    height: 10px;
    margin-right: 4px;
}

QMenu::icon:disabled {
    opacity: 0.5;
}

QMenu::item:!has-icon {
    padding-left: 32px;
}

QMenu::indicator {
    /* width/height: из ui.menu_indicator_size (config_loader.get_menu_indicator_size()) */
    margin-left: 4px;
}

QMenu::indicator:checked {
    border-radius: 3px;
}

/* Дефолт на TreeView — все визуальные параметры задаются темами */
QTreeView {}

/* =========================
   Меню-бар (верхнее системное меню)
   Настройка из конфигурации:
   - ui.menubar_font_size
   - ui.menubar_item_height
   ========================= */
QMenuBar {
    padding: 0;
    border: none;
    border-radius: 0;
    spacing: 0;
    margin: 0;
}

QMenuBar::item {
    padding: 4px 10px;
    border-radius: 0;
    margin: 0;
    /* font-size: из ui.menubar_font_size; min-height: из ui.menubar_item_height */
    font-weight: normal;
}

QMenuBar QMenu {
    margin-top: 2px;
    padding: 2px 0;
    border-radius: 0;
}

QMenuBar QMenu::item {
    padding: 4px 24px 4px 8px;
    min-width: 120px;
    min-height: 24px;
}

/* Базовая типографика для всех виджетов */
QWidget { font-family: "Segoe UI", sans-serif; }

/* =========================
   Верхняя панель — фоновые фреймы панелей (без цветов)
   Доп. настройка из кода:
   - ui.top_panel_container_height (fixedHeight контейнера)
   - ui.top_bar_margins (отступы layout сверху/снизу/слева/справа)
   - ui.layout.spacing.top_bar (расстояние между элементами тулбара)
   - ui.top_panel_icon_size, ui.quick_button_size (размеры кнопок/иконок)
   ========================= */
QFrame#favPanelBg,
QFrame#quickAddPanelBg {
    border-radius: 0;
    /* min-height устанавливается динамически из config_loader.get_top_panel_button_size() */
    margin: 0;
    padding: 0;
}

/* Recent: без дополнительного внутреннего отступа, чтобы ширина считалась точно */
QFrame#recentPanelBg {
    border-radius: 0;
    margin: 0;
    padding: 0;
}

/* Поле поиска в верхней панели (общие размеры и внутренние отступы) */
QWidget#topPanelContainer QLineEdit {
    border-radius: 0;
    min-height: 32px;
    max-height: 32px;
    margin: 0;
    padding: 0 8px;
    vertical-align: middle;
}

/* Контейнер верхней панели и его прямые дети — без внешних отступов
   Примечание: высота контейнера задаётся из кода (ui.top_panel_container_height),
   отступы/spacing layout — из кода (ui.top_bar_margins, ui.layout.spacing.top_bar) */
QWidget#topPanelContainer {
    margin: 0;
    padding: 0;
}

QWidget#topPanelContainer > QWidget {
    margin: 0;
    padding: 0;
}

QWidget#topPanelContainer QToolButton {
    border: none;
    border-radius: 6px;
    padding: 0;
    margin: 0;
    min-height: 32px;
    max-height: 32px;
    /* Размеры кнопок и иконок верхней панели выставляются из кода
       (например, ui.top_panel_icon_size, ui.quick_button_size) */
}

/* Кнопки верхней панели типа QPushButton — приводим к тем же размерам */
QWidget#topPanelContainer QPushButton {
    border: none;
    border-radius: 6px;
    padding: 0;
    margin: 0;
    min-height: 32px;
    max-height: 32px;
}

/* Поле поиска — альтернативный профиль размеров (используется в некоторых конфигурациях) */
QWidget#topPanelContainer QLineEdit {
    border: 1px solid;
    border-radius: 0;
    min-height: 32px;
    max-height: 32px;
    padding: 0 8px;
}

/* Специфический стиль поискового поля (перебивает общие и темовые правила) */
QLineEdit#mainSearch {
    border-radius: 0;
    min-height: 32px;
    max-height: 32px;
    padding: 0 8px;
}

/* =========================
   Базовые кнопки (вне верхней панели)
   ========================= */
QPushButton {
    border: 1px solid;
    border-radius: 4px;
    padding: 4px 8px;
}

QPushButton:pressed {
    border-style: inset;
}



/* =========================
   QToolButton (общие правила вне верхней панели)
   ========================= */
QToolButton {
    border: 1px solid;
    padding: 4px 8px;
    border-radius: 4px;
}

QToolButton:hover {
    border: 1px solid;
}

QToolButton:pressed {
    border: 1px solid;
}

QToolButton:checked {
    border: 1px solid;
}

/* Поля ввода (общие) */
QLineEdit, QTextEdit, QComboBox, QSpinBox {
    border: 1px solid;
    border-radius: 0;
    padding: 2px;
}



/* Выпадающий список у QComboBox */
QComboBox QAbstractItemView {
    border: 1px solid;
    border-radius: 0;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding-left: 4px;
}

/* Заголовки колонок в таблицах/деревьях */
QHeaderView::section {
    border-right: 1px solid;
    padding: 4px;
}



QHeaderView::section:last {
    border-right: none;
}

/* Лейбл пути в статус-баре */
QLabel#pathLabel {
    font-weight: normal;
    padding: 2px 8px;
}

QTableWidget QTableCornerButton::section,
QTableWidget QTableCornerButton::section:first {
}

QTableWidget QTableCornerButton::section:alternate {
}

/* Таблицы — базовая раскладка без рамок (цвета — в темах) */
QTableWidget {
    border: none;
    border-radius: 0;
    outline: none;
}

QTableWidget::item {
    border: none;
    border-radius: 0px;
}



QTreeWidget::item:selected,
QTableWidget::item:selected {
    border-radius: 0px;
}

QTreeWidget::item:hover {
    border-radius: 0px;
}

/* Горизонтальные/вертикальные разделители (фон/цвета задаются темами)
   Высота задаётся из конфигурации: ui.separator_height (app_config.json: ui.separator.height) */
QWidget[class="separator"] {
    border: none;
    min-height: 1px;
    max-height: 1px;
    margin: 0;
    padding: 0;
}

/* =========================
   Статус-бар
   ========================= */
QStatusBar {
    border-top: 1px solid;
}

QStatusBar::item {
    border: none;
}

/* Нижняя панель (контейнер) */
QWidget#bottomBarContainer {
    border: none !important;
    border-top: 1px solid;
    border-bottom: 1px solid;
}

/* Тонкие вертикальные разделители в верхней панели
   Геометрия (width/height) задаётся ТОЛЬКО из кода через app_config:
   - ui.separator_width, ui.separator_height */
QWidget#favQuickSeparatorBefore,
QWidget#favQuickSeparatorAfter {
    /* geometry set in code */
}

/* Универсальный вертикальный разделитель (геометрия задаётся из кода при создании) */
QWidget[class="vertical_separator"] {}

/* Ползунок сплиттера (толщина/геометрия)
   Толщина задаётся из кода: ui.splitter_handle_width */
QSplitter::handle {}

QSplitter::handle:horizontal {
    margin: 0;
    padding: 0;
}

QSplitter::handle:vertical {
    margin: 0;
    padding: 0;
}

QTreeWidget::item {
    /* min-height: из ui.tree_item_height (config_loader.get_tree_item_height()) */
}

/* Панель сфер — контейнер (геометрия и скругления без цветов)
   Настройка из конфигурации (применяется из кода):
   - ui.spheres_bar_height
   - ui.spheres_layout_margins
   - ui.spheres_bar_margin_left, ui.spheres_bar_margin_right */
#spheres_bar {
    border: none;
    margin-bottom: 0;
    border-radius: 0;
    padding: 0;
}

/* Любые скролл-области — убираем рамку (цвета — в темах) */
QAbstractScrollArea {
    border: none;
}

/* Скроллбар вертикальный (размеры — из конфигурации)
   Ширина: ui.scrollbar_width */
QScrollBar:vertical {
    border: none;
    /* width устанавливается динамически из config_loader.get_scrollbar_width() */
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    min-height: 20px;
}



QScrollBar::add-line:vertical {
    height: 0px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
    height: 0px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

/* Скроллбар горизонтальный (размеры — из конфигурации)
   Высота: ui.scrollbar_height */
QScrollBar:horizontal {
    border: none;
    /* height устанавливается динамически из config_loader.get_scrollbar_height() */
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:horizontal {
    min-width: 20px;
}

QScrollBar::add-line:horizontal {
    width: 0px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
    width: 0px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QTreeView::item {
    /* height устанавливается динамически из config_loader.get_tree_item_height() */
}